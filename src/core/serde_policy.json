        {"direction": "read", "props": {"timestamp.formats": "yyyy-MM-dd'T'HH:mm:ss"}, "lines": ["{\"id\": 1, \"name\": \"a\"}"], "expect": ["1\ta"], "warns": true},
        {"direction": "write", "props": {"timestamp.formats": "yyyy-MM-dd'T'HH:mm:ss"}, "insert": "(1, 'a')", "content": "{\"id\":1,\"name\":\"a\"}<nl>", "expect": ["1\ta"]}
      ]
    },
    {
      "key": "ignore.malformed.json", "serdes": ["HIVE_JSON"],
      "read": {"action": "ignore"},
      "write": {"action": "ignore"},
      "notes": "Not a property of this SerDe: a malformed line fails the query.",
      "tests": [
        {"direction": "read", "props": {"ignore.malformed.json": "true"}, "lines": ["{\"id\": 1, \"name\": \"a\"}", "not json"], "error": "Malformed JSON"},
        {"direction": "write", "props": {"ignore.malformed.json": "true"}, "insert": "(1, 'a')", "content": "{\"id\":1,\"name\":\"a\"}<nl>", "expect": ["1\ta"]}
      ]
    }
