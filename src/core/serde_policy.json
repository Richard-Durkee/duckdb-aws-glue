      "tests": [
        {"direction": "read", "props": {"case.insensitive": "TRUE"}, "lines": ["{\"id\": 1, \"name\": \"a\"}"], "expect": ["1\ta"], "warns": true},
        {"direction": "read", "props": {"case.insensitive": "false"}, "lines": ["{\"id\": 1, \"Name\": \"a\"}"], "expect": ["1\tNULL"]}
      ]
    },
