      "key": "mapping.", "prefix": true, "serdes": ["OPENX_JSON"],
      "read": {"action": "warn", "refuse_when": "non_empty"},
      "write": {"action": "ignore"},
      "notes": "mapping.<column> = <key>: not applied, a warning is logged.",
      "tests": [
        {"direction": "read", "props": {"mapping.name": "Name"}, "lines": ["{\"id\": 1, \"name\": \"a\", \"Name\": \"b\"}"], "expect": ["1\ta"], "warns": true}
      ]
    },
    {
      "key": "dots.in.keys", "serdes": ["OPENX_JSON"], "default": "false",
      "read": {"action": "warn", "refuse_when": "true"},
      "write": {"action": "ignore"},
      "notes": "Not applied: a warning is logged when it is true.",
      "tests": [
        {"direction": "read", "props": {"dots.in.keys": "true"}, "lines": ["{\"id\": 1, \"name\": \"a\"}"], "expect": ["1\ta"], "warns": true}
      ]
    },
    {
      "key": "timestamp.formats", "serdes": ["HIVE_JSON"],
      "read": {"action": "warn", "refuse_when": "non_empty"},
      "write": {"action": "ignore"},
