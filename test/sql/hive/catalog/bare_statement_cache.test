# name: test/sql/hive/catalog/bare_statement_cache.test
# description: bare statements (no explicit BEGIN) serve and invalidate the connection-scoped metadata cache; the auto-transaction they start does not trip the DDL-in-transaction guard
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.bare_orders;

statement ok
CREATE TABLE my_datalake.default.bare_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.bare_orders VALUES (1, '2026-01-01'), (2, '2026-01-02');

# the connection scope is what a bare statement's cache lives in between statements
statement ok
SET glue_metadata_cache_scope = 'connection';

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

# --- glue_get_table_response always fetches (the response column carries the raw reply, which only a
# --- fresh call has) and seeds the cache for the binds that follow ---

query I
SELECT response IS NOT NULL FROM glue_get_table_response('my_datalake.default.bare_orders');
----
true

statement ok
CALL truncate_duckdb_logs();

# the repeat fetches again and its response is still the full reply
query I
SELECT response IS NOT NULL FROM glue_get_table_response('my_datalake.default.bare_orders');
----
true

query I
SELECT glue_calls('GetTable');
----
1

# but it warmed the cache: binding the table itself needs no GetTable
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.bare_orders;
----
2

query I
SELECT glue_calls('GetTable');
----
0

# --- a prepared statement is bound at PREPARE and again at EXECUTE; under 'connection' scope the
# --- second bind is served from the first one's fetch ---

statement ok
PREPARE bare_prepared AS SELECT count(*) FROM my_datalake.default.bare_orders;

statement ok
CALL truncate_duckdb_logs();

query I
EXECUTE bare_prepared;
----
2

query I
SELECT glue_calls('GetTable');
----
0

statement ok
DEALLOCATE bare_prepared;

# --- serving: the second bare glue_partitions call is answered from the first one's fetch ---

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

query I
SELECT glue_calls('GetPartitions');
----
0

# --- invalidation: a bare mutation clears the cache, the next read sees the NEW state ---
# (the regression this guards: Invalidate() was a no-op in a bare CALL, so this read stayed stale)

statement ok
CALL glue_add_partition('my_datalake.default.bare_orders', {dt: '2026-01-03'});

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02
2026-01-03

statement ok
CALL glue_drop_partition('my_datalake.default.bare_orders', {dt: '2026-01-03'});

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

# --- another session's write stays invisible to the connection-scoped cache until a local write invalidates ---

statement ok con2
CALL glue_add_partition('my_datalake.default.bare_orders', {dt: '2026-01-04'});

# still served from this connection's cache: the foreign partition is not seen
query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

# a local write invalidates; the next read sees the foreign partition too
statement ok
CALL glue_add_partition('my_datalake.default.bare_orders', {dt: '2026-01-05'});

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02
2026-01-04
2026-01-05

statement ok
CALL glue_drop_partition('my_datalake.default.bare_orders', {dt: '2026-01-04'});

statement ok
CALL glue_drop_partition('my_datalake.default.bare_orders', {dt: '2026-01-05'});

# --- a failed statement rolls the auto-transaction back, which clears the connection-scoped cache ---

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

statement error
SELECT no_such_column FROM my_datalake.default.bare_orders;
----
<REGEX>:.*no_such_column.*

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

query I
SELECT glue_calls('GetPartitions');
----
1

# --- the same from an explicit transaction: the error aborts it, and the rollback clears the
# --- connection-scoped cache, so the statement after ROLLBACK resolves fresh ---

statement ok
BEGIN;

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

statement error
SELECT no_such_column FROM my_datalake.default.bare_orders;
----
<REGEX>:.*no_such_column.*

statement ok
ROLLBACK;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders') ORDER BY dt;
----
2026-01-01
2026-01-02

query I
SELECT glue_calls('GetPartitions');
----
1

# --- an INSERT into an unpartitioned table invalidates too (files change with no partition to register) ---

statement ok
CREATE TABLE my_datalake.default.bare_flat (id INTEGER);

statement ok
INSERT INTO my_datalake.default.bare_flat VALUES (1);

query I
SELECT count(*) FROM my_datalake.default.bare_flat;
----
1

statement ok
INSERT INTO my_datalake.default.bare_flat VALUES (2);

statement ok
CALL truncate_duckdb_logs();

# an INSERT does not change the table definition: the bind keeps it, while the files are listed again
query I
SELECT count(*) FROM my_datalake.default.bare_flat;
----
2

query I
SELECT glue_calls('GetTable');
----
0

statement ok
DROP TABLE my_datalake.default.bare_flat;

# --- a CTAS invalidates as well: it registers a Glue table and writes its files in one statement ---

# warm the cache for a table the CTAS does not touch
query I
SELECT count(*) FROM my_datalake.default.bare_orders;
----
2

statement ok
CREATE TABLE my_datalake.default.bare_ctas AS SELECT 1 AS id;

statement ok
CALL truncate_duckdb_logs();

# the CTAS forgets only the table it creates: the untouched table keeps its cached definition
query I
SELECT count(*) FROM my_datalake.default.bare_orders;
----
2

query I
SELECT glue_calls('GetTable');
----
0

statement ok
DROP TABLE my_datalake.default.bare_ctas;

# --- database-level DDL forgets only that database ---

query I
SELECT count(*) FROM my_datalake.default.bare_orders;
----
2

statement ok
CREATE SCHEMA my_datalake.bare_schema;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.bare_orders;
----
2

query I
SELECT glue_calls('GetTable');
----
0

statement ok
DROP SCHEMA my_datalake.bare_schema;

# an ALTER TABLE SET (table properties) invalidates too: the next read serves the new parameters, not the cached ones
query I
SELECT parameters['bare_marker'] FROM glue_get_table_response('my_datalake.default.bare_orders');
----
NULL

statement ok
ALTER TABLE my_datalake.default.bare_orders SET (bare_marker = 'v1');

query I
SELECT parameters['bare_marker'] FROM glue_get_table_response('my_datalake.default.bare_orders');
----
v1

# a bare table mutation invalidates the cached table too: after DROP the cached entry must not be served
query I
SELECT count(*) FROM glue_get_table_response('my_datalake.default.bare_orders');
----
1

statement ok
DROP TABLE my_datalake.default.bare_orders;

statement error
SELECT count(*) FROM glue_get_table_response('my_datalake.default.bare_orders');
----
<REGEX>:.*does not exist.*

# --- the fix starts the catalog transaction inside the bare statement's auto-transaction; that must
# --- NOT trip the explicit-transaction DDL guard: BEGIN errors, the identical bare statement works ---

statement ok
BEGIN;

statement error
CREATE TABLE my_datalake.default.bare_guard (id INTEGER);
----
<REGEX>:TransactionContext Error.*This connection is currently in a transaction. Transaction support is not provided for Glue catalogs.*

statement ok
ROLLBACK;

statement ok
CREATE TABLE my_datalake.default.bare_guard (id INTEGER);

statement ok
DROP TABLE my_datalake.default.bare_guard;

# --- DETACH + re-ATTACH under the same alias gets a fresh cache: the new attach must not be served
# --- the old attach's metadata. Two layers guarantee this, and this test holds whichever applies first:
# --- DETACH erases the alias's entry from the detaching connection's cache state (so detached catalogs do not
# --- accumulate), and the entries are keyed by the attach identity, not the alias, for states a DETACH
# --- cannot reach ---

statement ok
CREATE TABLE my_datalake.default.det_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.det_orders', {dt: '2026-03-01'});

# warm the connection-scoped cache for this attach
query I
SELECT dt FROM glue_partitions('my_datalake.default.det_orders');
----
2026-03-01

# a foreign write that this connection's cache hides: served with no Glue call, old partition list
statement ok con2
CALL glue_add_partition('my_datalake.default.det_orders', {dt: '2026-03-02'});

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.det_orders');
----
2026-03-01

query I
SELECT glue_calls('GetPartitions');
----
0

statement ok
DETACH my_datalake;

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
CALL truncate_duckdb_logs();

# the re-attach resolves fresh instead of serving the previous attach's cached partition list
query I
SELECT dt FROM glue_partitions('my_datalake.default.det_orders') ORDER BY dt;
----
2026-03-01
2026-03-02

query I
SELECT glue_calls('GetPartitions');
----
1

statement ok
DROP TABLE my_datalake.default.det_orders;

# --- flipping the scope does not hide a local write: a write made while the scope is 'transaction'
# --- clears the connection-level caches too, so flipping back serves the post-write state ---

statement ok
CREATE TABLE my_datalake.default.flip_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.flip_orders', {dt: '2026-04-01'});

# warm the connection-scoped cache
query I
SELECT dt FROM glue_partitions('my_datalake.default.flip_orders');
----
2026-04-01

statement ok
SET glue_metadata_cache_scope = 'transaction';

statement ok
CALL glue_add_partition('my_datalake.default.flip_orders', {dt: '2026-04-02'});

statement ok
SET glue_metadata_cache_scope = 'connection';

statement ok
CALL truncate_duckdb_logs();

# the write under 'transaction' scope invalidated the connection-level cache: fresh resolve, both partitions
query I
SELECT dt FROM glue_partitions('my_datalake.default.flip_orders') ORDER BY dt;
----
2026-04-01
2026-04-02

query I
SELECT glue_calls('GetPartitions');
----
1

statement ok
DROP TABLE my_datalake.default.flip_orders;

# --- the same Glue catalog attached under two aliases: a write through one alias must not be hidden
# --- by the other alias's cache ---

statement ok
CREATE TABLE my_datalake.default.alias_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.alias_orders', {dt: '2026-05-01'});

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake_twin (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# warm the first alias's cache
query I
SELECT dt FROM glue_partitions('my_datalake.default.alias_orders');
----
2026-05-01

# write through the other alias, then read through the first: the write cleared both aliases' caches
statement ok
CALL glue_add_partition('my_datalake_twin.default.alias_orders', {dt: '2026-05-02'});

statement ok
CALL truncate_duckdb_logs();

query I
SELECT dt FROM glue_partitions('my_datalake.default.alias_orders') ORDER BY dt;
----
2026-05-01
2026-05-02

query I
SELECT glue_calls('GetPartitions');
----
1

statement ok
DETACH my_datalake_twin;

statement ok
DROP TABLE my_datalake.default.alias_orders;

# the default (transaction) scope is unaffected: bare metadata reads still work after a reset
statement ok
RESET glue_metadata_cache_scope;

statement ok
CREATE TABLE my_datalake.default.bare_orders (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
CALL glue_add_partition('my_datalake.default.bare_orders', {dt: '2026-02-01'});

query I
SELECT dt FROM glue_partitions('my_datalake.default.bare_orders');
----
2026-02-01

statement ok
DROP TABLE my_datalake.default.bare_orders;
