# name: test/sql/hive/catalog/batch_table_lookup_pages.test
# description: In a database larger than one GetTables page, a table the page left out is looked up directly in later transactions instead of reading the page again
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

require-env GLUE_FAULT_ENDPOINT

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.fault_paged_tables_btl;

loop i 1 4

statement ok
DROP TABLE IF EXISTS my_datalake.fault_paged_tables_btl.t{i};

endloop

# three tables, which the fault proxy pages two at a time in creation order: t1 and t2 are on the first page
loop i 1 4

statement ok
CREATE TABLE my_datalake.fault_paged_tables_btl.t{i} AS SELECT {i} AS id;

endloop

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok con2
attach '{GLUE_CATALOG_ID}' as paged_dl (
    TYPE glue,
    ENDPOINT '{GLUE_FAULT_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok con2
SET redact_http_logs = false;

statement ok con2
CALL enable_logging('HTTP', storage := 'memory');

# the first page does not hold t3, so t3 costs its own GetTable after it
statement ok con2
CALL truncate_duckdb_logs();

query I con2
SELECT count(*) FROM (SELECT id FROM paged_dl.fault_paged_tables_btl.t1 UNION ALL SELECT id FROM paged_dl.fault_paged_tables_btl.t3);
----
2

query II con2
SELECT glue_calls('GetTables'), glue_calls('GetTable');
----
1	2

# a later statement does not read that page again for t3
statement ok con2
CALL truncate_duckdb_logs();

query I con2
SELECT count(*) FROM (SELECT id FROM paged_dl.fault_paged_tables_btl.t1 UNION ALL SELECT id FROM paged_dl.fault_paged_tables_btl.t3);
----
2

query II con2
SELECT glue_calls('GetTables'), glue_calls('GetTable');
----
0	2

# t2 is on the page, so its lookup is batched
statement ok con2
CALL truncate_duckdb_logs();

query I con2
SELECT count(*) FROM (SELECT id FROM paged_dl.fault_paged_tables_btl.t1 UNION ALL SELECT id FROM paged_dl.fault_paged_tables_btl.t2);
----
2

query II con2
SELECT glue_calls('GetTables'), glue_calls('GetTable');
----
1	1

statement ok con2
DETACH paged_dl;

loop i 1 4

statement ok
DROP TABLE my_datalake.fault_paged_tables_btl.t{i};

endloop
