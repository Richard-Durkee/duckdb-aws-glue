# name: test/sql/hive/catalog/metadata_service.test
# description: Glue calls go through the metadata service: a statement asks for an object once, writes reuse what it fetched, and a caller can hand definitions over
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

statement ok
DROP TABLE IF EXISTS my_datalake.default.ms_parts;

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
CALL truncate_duckdb_logs();

# the binder looks the new name up twice: the first answer (missing) is kept for the statement
statement ok
CREATE TABLE my_datalake.default.ms_parts (v BIGINT, part INTEGER) PARTITIONED BY (part);

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.GetTable';
----
2

statement ok
CALL truncate_duckdb_logs();

# registering the partitions derives their storage descriptor from the definition the INSERT bound
statement ok
INSERT INTO my_datalake.default.ms_parts SELECT range, range % 5 FROM range(50);

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.BatchCreatePartition	1
AWSGlue.GetPartitions	1
AWSGlue.GetTable	1

statement ok
CALL truncate_duckdb_logs();

# ALTER rewrites the definition it bound (with its VersionId) instead of fetching it twice more
statement ok
ALTER TABLE my_datalake.default.ms_parts ADD COLUMN w INTEGER;

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetTable	1
AWSGlue.UpdateTable	1

query I
SELECT count(w) + count(*) FROM my_datalake.default.ms_parts;
----
50

statement ok
CALL truncate_duckdb_logs();

statement ok
COMMENT ON TABLE my_datalake.default.ms_parts IS 'counted';

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.GetTable	1
AWSGlue.UpdateTable	1

query I
SELECT comment FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ms_parts';
----
counted

statement ok
CALL truncate_duckdb_logs();

# the partitions an ALTER TABLE checks are asked for in one BatchGetPartition
statement ok
ALTER TABLE my_datalake.default.ms_parts ADD PARTITION (part = 10) PARTITION (part = 11) PARTITION (part = 12);

query II
SELECT request.headers['x-amz-target'], count(*) FROM duckdb_logs_parsed('HTTP')
WHERE request.headers['x-amz-target'] IS NOT NULL GROUP BY 1 ORDER BY 1;
----
AWSGlue.BatchCreatePartition	1
AWSGlue.BatchGetPartition	1
AWSGlue.GetTable	1

statement error
ALTER TABLE my_datalake.default.ms_parts ADD PARTITION (part = 13) PARTITION (part = 11);
----
<REGEX>:.*Partition \[11\] already exists.*

statement error
ALTER TABLE my_datalake.default.ms_parts DROP PARTITION (part = 99);
----
<REGEX>:.*Partition \[99\] does not exist.*

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.ms_parts');
----
8

# a definition the caller already holds is used instead of asking Glue
statement ok
SET VARIABLE ms_table = (SELECT response::JSON::VARCHAR FROM glue_get_table_response('my_datalake.default.ms_parts'));

statement ok
SET VARIABLE ms_partitions = (SELECT json_group_array(json_object('Values', [part::VARCHAR], 'StorageDescriptor', json_object('Location', location))) FROM glue_partitions('my_datalake.default.ms_parts'));

statement ok
BEGIN;

query I
SELECT * FROM glue_provide_table('my_datalake.default', getvariable('ms_table'));
----
ms_parts

query I
SELECT * FROM glue_provide_partitions('my_datalake.default.ms_parts', getvariable('ms_partitions'));
----
8

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.ms_parts WHERE part = 3;
----
10

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] IS NOT NULL;
----
0

statement ok
COMMIT;

statement error
SELECT * FROM glue_provide_table('my_datalake.default', '{"NotATable": 1}');
----
<REGEX>:.*Not a Glue Table object.*

statement ok
DROP TABLE my_datalake.default.ms_parts;
