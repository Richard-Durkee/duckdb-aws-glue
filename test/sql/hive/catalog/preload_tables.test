# name: test/sql/hive/catalog/preload_tables.test
# description: glue_preload_tables gives the connection a table's Glue definition, so binding it calls no GetTable
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pre_orders;

statement ok
CREATE TABLE my_datalake.default.pre_orders (id BIGINT, v BIGINT, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.pre_orders SELECT i, i * 10, 'd' || (i % 3)::VARCHAR FROM range(30) r(i);

# the definition this connection will hand back, as Glue returned it
statement ok
SET VARIABLE orders_definition = (
    SELECT response::JSON::VARCHAR FROM glue_get_table_response('my_datalake.default.pre_orders')
);

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

#---------------------------------------------------------------------------
# without a definition the bind fetches the table
#---------------------------------------------------------------------------
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.pre_orders;
----
30

query I
SELECT glue_calls('GetTable') > 0;
----
true

#---------------------------------------------------------------------------
# with one, it does not
#---------------------------------------------------------------------------
statement ok
SET glue_metadata_cache_scope = 'transaction';

query II
CALL glue_preload_tables([{'table': 'my_datalake.default.pre_orders',
                           'definition': getvariable('orders_definition')}]);
----
default	pre_orders

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.pre_orders;
----
30

query II
SELECT glue_calls('GetTable'), glue_calls('GetTables');
----
0	0

# the same rows as the fetched definition gives: the partitions are still Glue's
query II
SELECT dt, count(*) FROM my_datalake.default.pre_orders GROUP BY dt ORDER BY dt;
----
d0	10
d1	10
d2	10

#---------------------------------------------------------------------------
# a mutation drops the definitions: what Glue holds may no longer be what was given
#---------------------------------------------------------------------------
statement ok
CALL glue_preload_tables([{'table': 'my_datalake.default.pre_orders',
                           'definition': getvariable('orders_definition')}]);

statement ok
CREATE OR REPLACE TABLE my_datalake.default.pre_other (id BIGINT);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.pre_orders;
----
30

query I
SELECT glue_calls('GetTable') > 0;
----
true

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
statement error
CALL glue_preload_tables([{'table': 'pre_orders', 'definition': getvariable('orders_definition')}]);
----
<REGEX>:.*needs the catalog and database.*

statement error
CALL glue_preload_tables([{'table': 'my_datalake.default.pre_orders', 'definition': 'not json'}]);
----
<REGEX>:.*Not a Glue table.*

statement error
CALL glue_preload_tables([{'table': 'my_datalake.default.pre_orders', 'definition': '{"Foo": 1}'}]);
----
<REGEX>:.*Not a Glue table: no 'Name'.*

# a definition of another table is refused, rather than read as this one
statement error
CALL glue_preload_tables([{'table': 'my_datalake.default.pre_other', 'definition': getvariable('orders_definition')}]);
----
<REGEX>:.*'pre_orders' was given as the definition of 'pre_other'.*

statement ok
DROP TABLE my_datalake.default.pre_orders;

statement ok
DROP TABLE my_datalake.default.pre_other;
