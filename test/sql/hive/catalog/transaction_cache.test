# name: test/sql/hive/catalog/transaction_cache.test
# description: A table referenced more than once in a transaction is resolved from Glue once; the partition list is fixed for the transaction, files are not; an aborted transaction leaves nothing cached; multi-level partitioned tables behave the same
# group: [catalog]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.tc_orders;

statement ok
CREATE TABLE my_datalake.default.tc_orders (id INTEGER, amount DOUBLE, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.tc_orders VALUES (1, 10.0, '2026-01-01'), (2, 20.0, '2026-01-02'), (3, 30.0, '2026-01-03');

statement ok
CREATE MACRO glue_calls(api) AS (
    SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.' || api
);

statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

# one reference
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

# one fetch of the table for the catalog entry and the scan together, and one GetPartitions (one request:
# against a server given with ENDPOINT the partitions are fetched in a single segment, and they fit one page)
query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
1	1

# two references in one statement: the same cost as one
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM (SELECT id FROM my_datalake.default.tc_orders UNION ALL SELECT id FROM my_datalake.default.TC_ORDERS);
----
6

query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
1	1

# the next statement (its own transaction) resolves again
statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
1	1

# inside BEGIN ... COMMIT the second statement is served from the first
statement ok
BEGIN;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

query II
SELECT glue_calls('GetPartitions'), glue_calls('GetTable');
----
0	0

# Glue DDL stays rejected inside an explicit transaction (no transaction support in Glue)
statement error
CALL glue_add_partition('my_datalake.default.tc_orders', {dt: '2026-01-04'});
----
<REGEX>:.*Transaction.*

statement ok
COMMIT;

# a partition added between transactions invalidates: the next statement resolves again
statement ok
CALL glue_add_partition('my_datalake.default.tc_orders', {dt: '2026-01-04'});

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

query I
SELECT glue_calls('GetPartitions');
----
1

# inside a transaction the partition list is fixed but files are listed per scan: a row inserted by a second
# connection into a new partition is not seen until the transaction ends, a row inserted into an existing
# partition is seen at once (metadata functions such as glue_partitions() are served through the same cache,
# so inside this transaction they would show the cached partition list too)
statement ok
BEGIN;

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
3

# existing partition: seen, the directory is listed by the scan
statement ok con2
INSERT INTO my_datalake.default.tc_orders VALUES (5, 50.0, '2026-01-01');

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
4

# new partition: not seen, the partition list is the transaction's
statement ok con2
INSERT INTO my_datalake.default.tc_orders VALUES (4, 40.0, '2026-01-05');

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
4

statement ok
COMMIT;

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
5

# the cache does not change what is read
query III
SELECT id, amount, dt FROM my_datalake.default.tc_orders ORDER BY id;
----
1	10.0	2026-01-01
2	20.0	2026-01-02
3	30.0	2026-01-03
4	40.0	2026-01-05
5	50.0	2026-01-01

# an error inside an explicit transaction aborts it: DuckDB refuses further statements until ROLLBACK,
# and nothing the aborted transaction resolved is served after it - the next statement fetches fresh
statement ok
BEGIN;

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
5

statement error
SELECT no_such_column FROM my_datalake.default.tc_orders;
----
<REGEX>:.*no_such_column.*

statement error
SELECT count(*) FROM my_datalake.default.tc_orders;
----
<REGEX>:.*(aborted|invalidated).*

statement ok
ROLLBACK;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_orders;
----
5

query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
1	1

# under the default (transaction) scope a prepared statement's execute-time bind refetches: prepare and
# execute run in two transactions and the cache does not outlive the first
statement ok
PREPARE tc_prepared AS SELECT count(*) FROM my_datalake.default.tc_orders;

statement ok
CALL truncate_duckdb_logs();

query I
EXECUTE tc_prepared;
----
5

query I
SELECT glue_calls('GetTable');
----
1

statement ok
DEALLOCATE tc_prepared;

# a table partitioned by two keys caches and prunes the same: served within the transaction,
# re-resolved after a partition with both keys is registered
statement ok
CREATE TABLE my_datalake.default.tc_sales (id INTEGER, y VARCHAR, m VARCHAR) PARTITIONED BY (y, m);

statement ok
INSERT INTO my_datalake.default.tc_sales VALUES (1, '2025', '01'), (2, '2025', '02'), (3, '2026', '01');

statement ok
BEGIN;

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM my_datalake.default.tc_sales;
----
3

query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
1	1

statement ok
CALL truncate_duckdb_logs();

# the second statement is served from the first; pruning on both partition levels reads through the cache
query I
SELECT count(*) FROM my_datalake.default.tc_sales WHERE y = '2025' AND m = '01';
----
1

query II
SELECT glue_calls('GetTable'), glue_calls('GetPartitions');
----
0	0

statement ok
COMMIT;

# registering a partition with values for both keys invalidates: the next statement sees it
statement ok
CALL glue_add_partition('my_datalake.default.tc_sales', {y: '2026', m: '02'});

statement ok
CALL truncate_duckdb_logs();

query II
SELECT y, m FROM glue_partitions('my_datalake.default.tc_sales') ORDER BY y, m;
----
2025	01
2025	02
2026	01
2026	02

query I
SELECT glue_calls('GetPartitions');
----
1

statement ok
DROP TABLE my_datalake.default.tc_sales;

statement ok
DROP TABLE my_datalake.default.tc_orders;
