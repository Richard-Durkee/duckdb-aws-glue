# name: test/sql/hive/ddl/alter_column/alter_table_alter_column_using.test
# description: ALTER TABLE ALTER COLUMN TYPE ... USING on a Hive table registered in Glue
# group: [alter_column]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.altusing_tbl;

statement ok
CREATE TABLE my_datalake.default.altusing_tbl (i INTEGER, j INTEGER);

statement ok
INSERT INTO my_datalake.default.altusing_tbl VALUES (1, 10), (2, 20);

# the data files can not be rewritten, so a USING expression is refused
statement error
ALTER TABLE my_datalake.default.altusing_tbl ALTER COLUMN i TYPE BIGINT USING i + 100;
----
<REGEX>:Not implemented Error:.*USING is not supported for Hive tables.*

statement error
ALTER TABLE my_datalake.default.altusing_tbl ALTER COLUMN i SET DATA TYPE BIGINT USING j;
----
<REGEX>:Not implemented Error:.*USING is not supported for Hive tables.*

statement error
ALTER TABLE my_datalake.default.altusing_tbl ALTER COLUMN i TYPE BIGINT USING i::VARCHAR;
----
<REGEX>:Not implemented Error:.*USING is not supported for Hive tables.*

# nothing changed
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'altusing_tbl' ORDER BY column_index;
----
i	INTEGER
j	INTEGER

query II
SELECT i, j FROM my_datalake.default.altusing_tbl ORDER BY i;
----
1	10
2	20

# a USING that is the plain cast of the column is what ALTER COLUMN TYPE does anyway
statement ok
ALTER TABLE my_datalake.default.altusing_tbl ALTER COLUMN i TYPE BIGINT USING CAST(i AS BIGINT);

statement ok
ALTER TABLE my_datalake.default.altusing_tbl ALTER COLUMN j TYPE BIGINT;

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'altusing_tbl' ORDER BY column_index;
----
i	BIGINT
j	BIGINT

query II
SELECT i, j FROM my_datalake.default.altusing_tbl ORDER BY i;
----
1	10
2	20

statement ok
DROP TABLE my_datalake.default.altusing_tbl;
