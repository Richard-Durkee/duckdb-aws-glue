# name: test/sql/hive/ddl/alter_column/alter_table_drop_column.test
# description: ALTER TABLE DROP COLUMN on a Hive table registered in Glue
# group: [alter_column]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_drop_column;

statement ok
CREATE TABLE my_datalake.default.ddl_drop_column (id INTEGER, name VARCHAR, score DOUBLE);

statement ok
ALTER TABLE my_datalake.default.ddl_drop_column DROP COLUMN name;

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_drop_column' ORDER BY column_index;
----
id	INTEGER
score	DOUBLE

statement ok
ALTER TABLE my_datalake.default.ddl_drop_column DROP COLUMN IF EXISTS name;

# dropping a column that does not exist without IF EXISTS is an error
statement error
ALTER TABLE my_datalake.default.ddl_drop_column DROP COLUMN name;
----

# the last data column can not be dropped
statement error
ALTER TABLE my_datalake.default.ddl_drop_column DROP COLUMN id, DROP COLUMN score;
----

# a second attach sees the change, it is stored in Glue and not only in the cached entry
statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake_2 (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

query II
SELECT column_name, data_type FROM duckdb_columns() WHERE database_name = 'my_datalake_2' AND table_name = 'ddl_drop_column' ORDER BY column_index;
----
id	INTEGER
score	DOUBLE

statement ok
DROP TABLE my_datalake.default.ddl_drop_column;

# a bucket or sort column can not be dropped: Glue would go on naming it in BucketColumns / SortColumns
statement ok
SET glue_create_bucketed_tables = true;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_drop_bucket_column;

statement ok
CREATE TABLE my_datalake.default.ddl_drop_bucket_column (id INTEGER, region VARCHAR, score DOUBLE, note VARCHAR)
WITH (BucketColumns = ['id'], NumberOfBuckets = 4, SortColumns = [{'Column': 'region', 'SortOrder': 0}]);

statement error
ALTER TABLE my_datalake.default.ddl_drop_bucket_column DROP COLUMN id;
----
Column "id" is a bucket column of table "ddl_drop_bucket_column" and can not be dropped

statement error
ALTER TABLE my_datalake.default.ddl_drop_bucket_column DROP COLUMN REGION;
----
is a sort column of table "ddl_drop_bucket_column" and can not be dropped

statement ok
ALTER TABLE my_datalake.default.ddl_drop_bucket_column DROP COLUMN note;

query I
SELECT column_name FROM duckdb_columns() WHERE database_name = 'my_datalake' AND table_name = 'ddl_drop_bucket_column' ORDER BY column_index;
----
id
region
score

query II
SELECT response.StorageDescriptor.BucketColumns::VARCHAR[], response.StorageDescriptor.SortColumns[1].Column::VARCHAR
FROM glue_get_table_response('my_datalake.default.ddl_drop_bucket_column');
----
[id]	region

statement ok
DROP TABLE my_datalake.default.ddl_drop_bucket_column;

#---------------------------------------------------------------------------
# csv tables: the files hold their fields by position, so dropping a column would shift every later field
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_drop_csv;

statement ok
CREATE TABLE my_datalake.default.ddl_drop_csv (id INTEGER, name VARCHAR, score DOUBLE) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.ddl_drop_csv VALUES (1, 'a', 9.5), (2, 'b', 8.0);

statement error
ALTER TABLE my_datalake.default.ddl_drop_csv DROP COLUMN name;
----
<REGEX>:.*Can not drop column "name" of csv table "ddl_drop_csv": its files hold their fields by position.*

# the trailing column too: the files would have a field more than the table
statement error
ALTER TABLE my_datalake.default.ddl_drop_csv DROP COLUMN score;
----
<REGEX>:.*Can not drop column "score" of csv table "ddl_drop_csv".*

# a column that does not exist is still no error with IF EXISTS
statement ok
ALTER TABLE my_datalake.default.ddl_drop_csv DROP COLUMN IF EXISTS missing;

# nothing changed: the table reads as written
query III
SELECT id, name, score FROM my_datalake.default.ddl_drop_csv ORDER BY id;
----
1	a	9.5
2	b	8.0

statement ok
DROP TABLE my_datalake.default.ddl_drop_csv;

# OpenCSVSerde as well
statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_drop_opencsv;

statement ok
CREATE TABLE my_datalake.default.ddl_drop_opencsv (id INTEGER, name VARCHAR) WITH (format = 'csv', quote = '"');

query I
SELECT serde_library FROM glue_get_table_response('my_datalake.default.ddl_drop_opencsv');
----
org.apache.hadoop.hive.serde2.OpenCSVSerde

statement error
ALTER TABLE my_datalake.default.ddl_drop_opencsv DROP COLUMN name;
----
<REGEX>:.*Can not drop column "name" of csv table "ddl_drop_opencsv".*

statement ok
DROP TABLE my_datalake.default.ddl_drop_opencsv;

# json files hold their fields by name: dropping a column is fine, the other columns still read their own values
statement ok
DROP TABLE IF EXISTS my_datalake.default.ddl_drop_json;

statement ok
CREATE TABLE my_datalake.default.ddl_drop_json (id INTEGER, name VARCHAR, score DOUBLE) WITH (format = 'json');

statement ok
INSERT INTO my_datalake.default.ddl_drop_json VALUES (1, 'a', 9.5), (2, 'b', 8.0);

statement ok
ALTER TABLE my_datalake.default.ddl_drop_json DROP COLUMN name;

query II
SELECT id, score FROM my_datalake.default.ddl_drop_json ORDER BY id;
----
1	9.5
2	8.0

statement ok
DROP TABLE my_datalake.default.ddl_drop_json;
