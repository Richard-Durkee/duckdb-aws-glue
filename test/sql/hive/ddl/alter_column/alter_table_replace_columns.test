# name: test/sql/hive/ddl/alter_column/alter_table_replace_columns.test
# description: ALTER TABLE ... [PARTITION (...)] REPLACE COLUMNS (...) with DuckDB types, stored like CREATE TABLE
# group: [alter_column]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
SET active_grammar_extensions = ['glue_hive_ddl'];

foreach table replace_cols replace_cols_csv replace_cols_sorted

statement ok
DROP TABLE IF EXISTS my_datalake.default.{table};

endloop

statement ok
CREATE TABLE my_datalake.default.replace_cols (id INTEGER, name VARCHAR, extra DOUBLE, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.replace_cols VALUES (1, 'a', 1.5, '2024-01-01'), (2, 'b', 2.5, '2024-01-02');

#---------------------------------------------------------------------------
# the data columns are replaced as a whole, with comments; the partition keys stay
#---------------------------------------------------------------------------
query III
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (
    id BIGINT COMMENT 'the id',
    name VARCHAR,
    tags VARCHAR[],
    attrs MAP(VARCHAR, INTEGER),
    nested STRUCT(a INTEGER, b STRUCT(c VARCHAR)[]) COMMENT 'it''s nested, (really)',
    price DECIMAL(10, 2),
    "Mixed Case" DATE
);
----
replace columns	NULL	NULL

query III
SELECT unnest(columns, recursive := true) FROM glue_get_table_response('my_datalake.default.replace_cols');
----
id	bigint	the id
name	string	NULL
tags	array<string>	NULL
attrs	map<string,int>	NULL
nested	struct<a:int,b:array<struct<c:string>>>	it's nested, (really)
price	decimal(10,2)	NULL
Mixed Case	date	NULL

query II
SELECT partition_keys[1].name, len(partition_keys) FROM glue_get_table_response('my_datalake.default.replace_cols');
----
dt	1

# the catalog entry follows: the new columns, the partition key last
query II
SELECT column_name, data_type FROM duckdb_columns()
WHERE database_name = 'my_datalake' AND table_name = 'replace_cols' ORDER BY column_index;
----
id	BIGINT
name	VARCHAR
tags	VARCHAR[]
attrs	MAP(VARCHAR, INTEGER)
nested	STRUCT(a INTEGER, b STRUCT(c VARCHAR)[])
price	DECIMAL(10,2)
Mixed Case	DATE
dt	VARCHAR

# parquet columns are matched by name: 'id' is widened, the dropped 'extra' is gone, the new columns are NULL
query IIIII
SELECT id, name, tags, nested, dt FROM my_datalake.default.replace_cols ORDER BY id;
----
1	a	NULL	NULL	2024-01-01
2	b	NULL	NULL	2024-01-02

statement ok
INSERT INTO my_datalake.default.replace_cols (id, name, tags, dt) VALUES (3, 'c', ['x'], '2024-01-03');

query III
SELECT id, tags, dt FROM my_datalake.default.replace_cols WHERE id = 3;
----
3	[x]	2024-01-03

#---------------------------------------------------------------------------
# PARTITION (...) REPLACE COLUMNS changes the column schema one partition carries, not the table's
#---------------------------------------------------------------------------
query III
ALTER TABLE my_datalake.default.replace_cols PARTITION (DT = '2024-01-01') REPLACE COLUMNS (id INTEGER, name VARCHAR);
----
replace columns	2024-01-01	NULL

query I
SELECT len(columns) FROM glue_get_table_response('my_datalake.default.replace_cols');
----
7

statement error
ALTER TABLE my_datalake.default.replace_cols PARTITION (dt = '1999-01-01') REPLACE COLUMNS (id INTEGER);
----
Partition [1999-01-01] does not exist

#---------------------------------------------------------------------------
# glue_alter_table takes the columns as {name, type, comment} structs
#---------------------------------------------------------------------------
query III
CALL glue_alter_table('my_datalake.default.replace_cols', [{action: 'replace_columns', columns: [{name: 'id', type: 'BIGINT'}, {name: 'name', type: 'VARCHAR', comment: 'the name'}]}]);
----
replace columns	NULL	NULL

query III
SELECT unnest(columns, recursive := true) FROM glue_get_table_response('my_datalake.default.replace_cols');
----
id	bigint	NULL
name	string	the name

#---------------------------------------------------------------------------
# errors: nothing is changed
#---------------------------------------------------------------------------
statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id INTEGER, ID VARCHAR);
----
column 'ID' is given twice

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id INTEGER, DT VARCHAR);
----
'DT' is a partition key

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id frobnicate);
----
Type with name frobnicate does not exist

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id HUGEINT);
----
can not be converted to a Glue type

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id INTEGER) SET LOCATION 's3://elsewhere/t';
----
can not be combined with other ALTER TABLE actions

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS ();
----
Parser Error

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id);
----
Parser Error

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS (id INTEGER COMMENT 42);
----
Parser Error

statement error
CALL glue_alter_table('my_datalake.default.replace_cols', [{action: 'replace_columns', columns: [{name: 'id'}]}]);
----
every column needs a name and a type

statement error
CALL glue_alter_table('my_datalake.default.replace_cols', [{action: 'replace_columns', columns: []}]);
----
needs a list of {name, type, comment} columns

statement error
ALTER TABLE my_datalake.default.replace_cols REPLACE COLUMNS ('' INTEGER);
----
a column needs a name

statement error
ALTER TABLE my_datalake.default.replace_cols PARTITION (dt = '2024-01-01') REPLACE COLUMNS (id INTEGER, ID VARCHAR);
----
ALTER TABLE PARTITION REPLACE COLUMNS: column 'ID' is given twice

query I
SELECT len(columns) FROM glue_get_table_response('my_datalake.default.replace_cols');
----
2

#---------------------------------------------------------------------------
# the bucketing and sort columns must stay
#---------------------------------------------------------------------------
statement ok
SET glue_create_bucketed_tables = true;

statement ok
CREATE TABLE my_datalake.default.replace_cols_sorted (id INTEGER, name VARCHAR, extra VARCHAR) WITH (
    BucketColumns = ['id'], NumberOfBuckets = 4, SortColumns = [{'Column': 'name', 'SortOrder': 1}]);

statement error
ALTER TABLE my_datalake.default.replace_cols_sorted REPLACE COLUMNS (name VARCHAR);
----
the columns must keep 'id'

statement error
ALTER TABLE my_datalake.default.replace_cols_sorted REPLACE COLUMNS (id INTEGER);
----
the columns must keep 'name'

statement ok
ALTER TABLE my_datalake.default.replace_cols_sorted REPLACE COLUMNS (id BIGINT, name VARCHAR);

#---------------------------------------------------------------------------
# a csv table: columns are positional, so REPLACE COLUMNS renames them
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.replace_cols_csv (col1 VARCHAR, col2 VARCHAR, col3 VARCHAR) WITH (format = 'csv');

statement ok
INSERT INTO my_datalake.default.replace_cols_csv VALUES ('Ada', 'Lovelace', 'London');

statement ok
ALTER TABLE my_datalake.default.replace_cols_csv REPLACE COLUMNS (first_name VARCHAR, last_name VARCHAR, city VARCHAR);

query III
SELECT first_name, last_name, city FROM my_datalake.default.replace_cols_csv;
----
Ada	Lovelace	London

statement error
ALTER TABLE my_datalake.default.replace_cols_csv PARTITION (dt = 'x') REPLACE COLUMNS (id INTEGER);
----
is not partitioned

# an empty comment is no comment
statement ok
ALTER TABLE my_datalake.default.replace_cols_csv REPLACE COLUMNS (first_name VARCHAR COMMENT '', last_name VARCHAR, city VARCHAR);

query II
SELECT name, comment FROM (SELECT unnest(columns, recursive := true) FROM glue_get_table_response('my_datalake.default.replace_cols_csv'));
----
first_name	NULL
last_name	NULL
city	NULL

foreach table replace_cols replace_cols_csv replace_cols_sorted

statement ok
DROP TABLE my_datalake.default.{table};

endloop
