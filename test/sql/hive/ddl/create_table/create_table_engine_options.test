# name: test/sql/hive/ddl/create_table/create_table_engine_options.test
# description: CREATE TABLE refuses what other engines could not read or what would silently do nothing: other engines' CTAS properties, format parameters, types without a Hive type, a VARCHAR retype of parquet or avro; SerDe keys go to the SerDe
# group: [create_table]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# other engines' CTAS properties would be stored as parameters and do nothing: an unpartitioned table, a ',' delimiter
statement error
CREATE TABLE my_datalake.default.ath_opt WITH (partitioned_by = ['p']) AS SELECT 1 AS id, 'x' AS p;
----
<REGEX>:.*Unknown CREATE TABLE option 'partitioned_by' for a Hive table, use PARTITIONED BY.*

statement error
CREATE TABLE my_datalake.default.ath_opt WITH (format = 'csv', field_delimiter = '|') AS SELECT 1 AS id;
----
<REGEX>:.*Unknown CREATE TABLE option 'field_delimiter' for a Hive table, use option 'delimiter'.*

statement error
CREATE TABLE my_datalake.default.ath_opt WITH (external_location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/ath_opt') AS SELECT 1 AS id;
----
<REGEX>:.*Unknown CREATE TABLE option 'external_location' for a Hive table, use option 'location'.*

statement error
CREATE TABLE my_datalake.default.ath_opt WITH (parquet_compression = 'GZIP') AS SELECT 1 AS id;
----
<REGEX>:.*use option 'write_compression'.*

# a Hive table labelled Iceberg (or Delta) could not be read by any engine
statement error
CREATE TABLE my_datalake.default.ath_opt WITH (table_type = 'ICEBERG') AS SELECT 1 AS id;
----
<REGEX>:.*CREATE TABLE option 'table_type' decides how the table is read and can not be set.*

statement error
CREATE TABLE my_datalake.default.ath_opt (id INTEGER) WITH ('spark.sql.sources.provider' = 'delta');
----
<REGEX>:.*option 'spark.sql.sources.provider' decides how the table is read.*

# nothing was created by the refused statements
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'ath_opt';
----
0

# types Glue would store as 'time', 'timestamptz' or 'uuid', which other engines can not read
statement error
CREATE TABLE my_datalake.default.ath_opt (id INTEGER, t TIME);
----
<REGEX>:.*DuckDB type 'TIME' has no Hive type, cast it to VARCHAR.*

statement error
CREATE TABLE my_datalake.default.ath_opt AS SELECT TIMESTAMPTZ '2024-01-01 00:00:00+00' AS ts;
----
<REGEX>:.*has no Hive type, cast it to TIMESTAMP.*

statement error
CREATE TABLE my_datalake.default.ath_opt AS SELECT gen_random_uuid() AS u;
----
<REGEX>:.*DuckDB type 'UUID' has no Hive type, cast it to VARCHAR.*

statement ok
DROP TABLE IF EXISTS my_datalake.default.ath_opt_t;

statement ok
CREATE TABLE my_datalake.default.ath_opt_t (id INTEGER);

statement error
ALTER TABLE my_datalake.default.ath_opt_t ADD COLUMN u UUID;
----
<REGEX>:.*DuckDB type 'UUID' has no Hive type.*

# parquet (and avro) files keep their number types, which other engines can not read under a string column
statement error
ALTER TABLE my_datalake.default.ath_opt_t ALTER COLUMN id TYPE VARCHAR;
----
<REGEX>:.*Can not change column "id" of table "ath_opt_t" from INTEGER to VARCHAR: other engines can not read the existing parquet files as text.*

statement ok
ALTER TABLE my_datalake.default.ath_opt_t ALTER COLUMN id TYPE BIGINT;

statement ok
DROP TABLE my_datalake.default.ath_opt_t;

# a csv table still allows it: its files are text
statement ok
DROP TABLE IF EXISTS my_datalake.default.ath_opt_csv;

statement ok
CREATE TABLE my_datalake.default.ath_opt_csv WITH (format = 'csv') AS SELECT 1 AS id;

statement ok
ALTER TABLE my_datalake.default.ath_opt_csv ALTER COLUMN id TYPE VARCHAR;

statement ok
DROP TABLE my_datalake.default.ath_opt_csv;

# a SerDe key given as a WITH key is stored with the SerDe, not next to a different SerDe value
statement ok
DROP TABLE IF EXISTS my_datalake.default.ath_opt_delim;

statement ok
CREATE TABLE my_datalake.default.ath_opt_delim WITH (format = 'csv', 'field.delim' = '|') AS SELECT 1 AS id, 'a,b' AS s;

query IIII
SELECT serde_parameters['field.delim'], serde_parameters['serialization.format'], parameters['field.delim'] IS NULL,
       parameters['serialization.format'] IS NULL
FROM glue_get_table_response('my_datalake.default.ath_opt_delim');
----
|	|	true	true

query II
SELECT id, s FROM my_datalake.default.ath_opt_delim;
----
1	a,b

statement ok
DROP TABLE my_datalake.default.ath_opt_delim;
