# name: test/sql/hive/ddl/create_table/create_table_generated_columns.test
# description: CREATE TABLE with a generated column is refused: a Hive table can not hold one
# group: [create_table]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.gencol_t;

statement error
CREATE TABLE my_datalake.default.gencol_t (a INTEGER, b INTEGER GENERATED ALWAYS AS (a + 1));
----
Not implemented Error: Generated column "b" is not supported for tables in a Glue catalog

statement error
CREATE TABLE my_datalake.default.gencol_t (a INTEGER, b AS (a + 1) VIRTUAL);
----
Generated column "b" is not supported

statement error
CREATE TABLE my_datalake.default.gencol_t (a INTEGER, dt VARCHAR, b AS (a * 2)) PARTITIONED BY (dt);
----
Generated column "b" is not supported

# nothing was created in Glue
statement error
SELECT * FROM my_datalake.default.gencol_t;
----
does not exist

statement ok
CREATE TABLE my_datalake.default.gencol_t (a INTEGER, b INTEGER);

statement ok
INSERT INTO my_datalake.default.gencol_t VALUES (1, 2);

query II
SELECT a, b FROM my_datalake.default.gencol_t;
----
1	2

statement ok
DROP TABLE my_datalake.default.gencol_t;
