# name: test/sql/hive/ddl/drop_schema/drop_schema_restrict.test
# description: Glue deletes every table of a database along with it, so DROP SCHEMA only drops an empty Glue database;
# group: [drop_schema]

#              a database with tables or views takes CASCADE

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP SCHEMA IF EXISTS my_datalake.ddl_drop_restrict CASCADE;

statement ok
CREATE SCHEMA my_datalake.ddl_drop_restrict;

statement ok
CREATE TABLE my_datalake.ddl_drop_restrict.orders (id INTEGER);

statement ok
INSERT INTO my_datalake.ddl_drop_restrict.orders VALUES (1), (2);

statement error
DROP SCHEMA my_datalake.ddl_drop_restrict;
----
<REGEX>:.*Cannot drop Glue database "ddl_drop_restrict" because it still contains tables \(e\.g\. "orders"\).*CASCADE.*

statement error
DROP SCHEMA my_datalake.ddl_drop_restrict RESTRICT;
----
<REGEX>:.*still contains tables.*

statement error
DROP SCHEMA IF EXISTS my_datalake.ddl_drop_restrict;
----
<REGEX>:.*still contains tables.*

# the refused drops left the database and its data alone
query I
SELECT count(*) FROM my_datalake.ddl_drop_restrict.orders;
----
2

# Glue is asked directly: a table created through another attach also blocks the drop
statement ok
attach '{GLUE_CATALOG_ID}' as other_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE my_datalake.ddl_drop_restrict.orders;

statement ok
CREATE TABLE other_datalake.ddl_drop_restrict.late (id INTEGER);

statement error
DROP SCHEMA my_datalake.ddl_drop_restrict;
----
<REGEX>:.*still contains tables \(e\.g\. "late"\).*

statement ok
DROP TABLE other_datalake.ddl_drop_restrict.late;

# an empty database drops without CASCADE
statement ok
DROP SCHEMA my_datalake.ddl_drop_restrict;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'my_datalake' AND schema_name = 'ddl_drop_restrict';
----
0

# CASCADE drops the database together with its tables
statement ok
CREATE SCHEMA my_datalake.ddl_drop_restrict;

statement ok
CREATE TABLE my_datalake.ddl_drop_restrict.orders (id INTEGER);

statement ok
DROP SCHEMA my_datalake.ddl_drop_restrict CASCADE;

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'my_datalake' AND schema_name = 'ddl_drop_restrict';
----
0

statement error
SELECT * FROM glue_get_table_response('my_datalake.ddl_drop_restrict.orders');
----
does not exist
