# name: test/sql/hive/dml/formats/csv/test_csv_lazy_simple_values.test
# description: LazySimpleSerDe tables parse integers, floats, booleans, dates and timestamps as Hive's LazySimpleSerDe
# group: [csv]

#              does (LazyInteger, LazyDouble, LazyBoolean, LazyDate, LazyTimestamp); what does not parse is NULL

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_lazy_numbers;

statement ok
DROP TABLE IF EXISTS my_datalake.default.formats_csv_lazy_times;

#---------------------------------------------------------------------------
# integers: digits with an optional sign and nothing around them, a fraction dropped; floats: Java's parseDouble
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_csv_lazy_numbers (raw VARCHAR, i INTEGER, bi BIGINT, ti TINYINT, f FLOAT,
    d DOUBLE, b BOOLEAN) WITH (format = 'csv', delimiter = '|');

statement ok
COPY (SELECT raw || repeat('|' || raw, 6) FROM (VALUES ('7'), ('+5'), ('-0'), ('007'), ('12.9'), ('-12.9'), ('12.'),
    ('.5'), (' 9'), ('9 '), ('1_000'), ('0x1'), ('1e3'), ('128'), ('2147483648'), ('Infinity'), ('-Infinity'),
    ('NaN'), ('inf'), ('1.5f'), ('2d'), ('1.5e'), ('true'), ('FALSE'), ('t'), ('yes'), ('1'), ('')) t(raw))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_lazy_numbers/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query IIIIIII
SELECT '[' || raw || ']', i, bi, ti, f, d, b FROM my_datalake.default.formats_csv_lazy_numbers ORDER BY raw;
----
[]	NULL	NULL	NULL	NULL	NULL	NULL
[ 9]	NULL	NULL	NULL	9.0	9.0	NULL
[+5]	5	5	5	5.0	5.0	NULL
[-0]	0	0	0	-0.0	-0.0	NULL
[-12.9]	-12	-12	-12	-12.9	-12.9	NULL
[-Infinity]	NULL	NULL	NULL	-inf	-inf	NULL
[.5]	0	0	0	0.5	0.5	NULL
[007]	7	7	7	7.0	7.0	NULL
[0x1]	NULL	NULL	NULL	NULL	NULL	NULL
[1]	1	1	1	1.0	1.0	NULL
[1.5e]	NULL	NULL	NULL	NULL	NULL	NULL
[1.5f]	NULL	NULL	NULL	1.5	1.5	NULL
[12.]	12	12	12	12.0	12.0	NULL
[12.9]	12	12	12	12.9	12.9	NULL
[128]	128	128	NULL	128.0	128.0	NULL
[1_000]	NULL	NULL	NULL	NULL	NULL	NULL
[1e3]	NULL	NULL	NULL	1000.0	1000.0	NULL
[2147483648]	NULL	2147483648	NULL	2.1474836e+09	2147483648.0	NULL
[2d]	NULL	NULL	NULL	2.0	2.0	NULL
[7]	7	7	7	7.0	7.0	NULL
[9 ]	NULL	NULL	NULL	9.0	9.0	NULL
[FALSE]	NULL	NULL	NULL	NULL	NULL	false
[Infinity]	NULL	NULL	NULL	inf	inf	NULL
[NaN]	NULL	NULL	NULL	nan	nan	NULL
[inf]	NULL	NULL	NULL	NULL	NULL	NULL
[t]	NULL	NULL	NULL	NULL	NULL	NULL
[true]	NULL	NULL	NULL	NULL	NULL	true
[yes]	NULL	NULL	NULL	NULL	NULL	NULL

# filters compare the parsed values
query II
SELECT raw, i FROM my_datalake.default.formats_csv_lazy_numbers WHERE i = 12 ORDER BY raw;
----
12.	12
12.9	12

query I
SELECT count(*) FROM my_datalake.default.formats_csv_lazy_numbers WHERE b;
----
1

#---------------------------------------------------------------------------
# dates and timestamps: y-M-d [H:m:s[.f]] resolved leniently, ISO yyyy-MM-ddTHH:mm:ss for timestamps
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.formats_csv_lazy_times (raw VARCHAR, dt DATE, ts TIMESTAMP)
WITH (format = 'csv', delimiter = '|');

statement ok
COPY (SELECT raw || '|' || raw || '|' || raw FROM (VALUES ('2024-01-02'), (' 2024-01-02'), ('2024-1-5'),
    ('2024-02-30'), ('2024-13-01'), ('20240102'), ('24-1-5'), ('2024-01-02 03:04:05'), ('2024-01-02 3:4:5.5'),
    ('2024-01-02 03:04:05.123456789'), ('2024-01-02 25:00:00'), ('2024-01-02T03:04:05'), ('2024-01-02 x'),
    ('2024-01-02T3:04:05')) t(raw))
TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/formats_csv_lazy_times/data.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT '[' || raw || ']', dt, ts FROM my_datalake.default.formats_csv_lazy_times ORDER BY raw;
----
[ 2024-01-02]	2024-01-02	NULL
[2024-01-02]	2024-01-02	NULL
[2024-01-02 03:04:05]	2024-01-02	2024-01-02 03:04:05
[2024-01-02 03:04:05.123456789]	2024-01-02	2024-01-02 03:04:05.123456
[2024-01-02 25:00:00]	2024-01-02	2024-01-03 01:00:00
[2024-01-02 3:4:5.5]	2024-01-02	2024-01-02 03:04:05.5
[2024-01-02 x]	2024-01-02	NULL
[2024-01-02T03:04:05]	NULL	2024-01-02 03:04:05
[2024-01-02T3:04:05]	NULL	NULL
[2024-02-30]	2024-03-01	NULL
[2024-1-5]	2024-01-05	NULL
[2024-13-01]	2025-01-01	NULL
[20240102]	NULL	NULL
[24-1-5]	NULL	NULL

statement ok
DROP TABLE my_datalake.default.formats_csv_lazy_numbers;

statement ok
DROP TABLE my_datalake.default.formats_csv_lazy_times;
