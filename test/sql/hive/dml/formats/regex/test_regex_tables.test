# name: test/sql/hive/dml/formats/regex/test_regex_tables.test
# description: Hive tables with RegexSerDe: CREATE TABLE ... WITH (format = 'regex', 'input.regex' = ...), reads
# group: [regex]

#              through the catalog and hive_scan(format := 'regex'), and the errors for regexes and tables
#              RegexSerDe can not read. RegexSerDe tables can not be written.

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.regex_access;

statement ok
DROP TABLE IF EXISTS my_datalake.default.regex_types;

statement ok
DROP TABLE IF EXISTS my_datalake.default.regex_case;

statement ok
DROP TABLE IF EXISTS my_datalake.default.regex_bad;

#---------------------------------------------------------------------------
# a partitioned access log
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.regex_access (host VARCHAR, status INTEGER, bytes BIGINT, ok BOOLEAN, agent VARCHAR, dt VARCHAR)
PARTITIONED BY (dt)
WITH (format = 'regex', 'input.regex' = '(\S+) (\S+) (\S+) (\S+)(?: "([^"]*)")?', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_access');

# the Glue table describes it the way Hive expects a RegexSerDe table
query IIII
SELECT serde_library, serde_parameters['input.regex'],
       response.StorageDescriptor.InputFormat::VARCHAR, response.StorageDescriptor.OutputFormat::VARCHAR
FROM glue_get_table_response('my_datalake.default.regex_access');
----
org.apache.hadoop.hive.serde2.RegexSerDe	(\S+) (\S+) (\S+) (\S+)(?: "([^"]*)")?	org.apache.hadoop.mapred.TextInputFormat	org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat

# the lines, written as they are (no delimiter, quote or escape character in them)
statement ok
COPY (FROM (VALUES
    ('10.0.0.1 200 512 true "curl/8, linux"'),
    ('10.0.0.2 404 x TRUE'),
    ('10.0.0.3 500 99999999999 yes ""'),
    (''),
    ('-- not a log --')
) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_access/dt=2026-10-01/part.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER e'\x01');

# a gzip compressed file is read with the codec its name says
statement ok
COPY (SELECT '10.0.0.4 301 0 false' AS line) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_access/dt=2026-10-02/part.txt.gz' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER e'\x01', COMPRESSION gzip);

statement ok
CALL glue_add_partition('my_datalake.default.regex_access', {dt: '2026-10-01'});

statement ok
CALL glue_add_partition('my_datalake.default.regex_access', {dt: '2026-10-02'});

# every data column is a capture group: a value that does not convert is NULL ('x' as BIGINT), a group that does not
# take part in the match is NULL (no agent) while one that matches nothing is empty, BOOLEAN is true for 'true' in
# any case and false for anything else ('yes'), and a line the regex does not match as a whole is NULL in every data
# column (the empty line and '-- not a log --') but keeps its partition value
query IIIIII
SELECT * FROM my_datalake.default.regex_access ORDER BY dt, host NULLS LAST;
----
10.0.0.1	200	512	true	curl/8, linux	2026-10-01
10.0.0.2	404	NULL	true	NULL	2026-10-01
10.0.0.3	500	99999999999	false	(empty)	2026-10-01
NULL	NULL	NULL	NULL	NULL	2026-10-01
NULL	NULL	NULL	NULL	NULL	2026-10-01
10.0.0.4	301	0	false	NULL	2026-10-02

# every line is a row
query III
SELECT count(*), count(host), count(agent) FROM my_datalake.default.regex_access;
----
6	4	2

# a projection, filters on data and partition columns, and the filename
query IIT
SELECT status, bytes, parse_filename(filename) FROM my_datalake.default.regex_access WHERE status >= 300 AND dt = '2026-10-02';
----
301	0	part.txt.gz

query I
SELECT host FROM my_datalake.default.regex_access WHERE NOT ok ORDER BY host;
----
10.0.0.3
10.0.0.4

query II
SELECT dt, count(*) FROM my_datalake.default.regex_access GROUP BY dt ORDER BY dt;
----
2026-10-01	5
2026-10-02	1

# RegexSerDe has no serialize: the tables can only be read
statement error
INSERT INTO my_datalake.default.regex_access VALUES ('10.0.0.5', 200, 1, true, 'curl', '2026-10-03');
----
Can not write to Hive table 'default.regex_access': RegexSerDe tables can only be read

#---------------------------------------------------------------------------
# conversions to the column types
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.regex_types (d DOUBLE, day DATE, ts TIMESTAMP, amount DECIMAL(10, 2), small TINYINT)
WITH (format = 'regex', 'input.regex' = '([^,]*),([^,]*),([^,]*),([^,]*),([^,]*)', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_types');

statement ok
COPY (FROM (VALUES
    ('1.5,2026-10-01,2026-10-01 12:34:56.5,12.345,127'),
    ('one,2026-13-01,yesterday,abc,128')
) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_types/part.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER e'\x01');

query IIIII
SELECT * FROM my_datalake.default.regex_types ORDER BY d NULLS LAST;
----
1.5	2026-10-01	2026-10-01 12:34:56.5	12.35	127
NULL	NULL	NULL	NULL	NULL

# hive_scan reads the same files with the regex given to it
query IIIII
SELECT * FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_types',
    schema := {d: 'DOUBLE', day: 'DATE', ts: 'TIMESTAMP', amount: 'DECIMAL(10, 2)', small: 'TINYINT'},
    format := 'regex', regex := '([^,]*),([^,]*),([^,]*),([^,]*),([^,]*)')
ORDER BY d NULLS LAST;
----
1.5	2026-10-01	2026-10-01 12:34:56.5	12.35	127
NULL	NULL	NULL	NULL	NULL

#---------------------------------------------------------------------------
# input.regex.case.insensitive
#---------------------------------------------------------------------------
statement ok
CREATE TABLE my_datalake.default.regex_case (method VARCHAR, path VARCHAR)
WITH (format = 'regex', 'input.regex' = '(GET|POST) (\S+)', 'input.regex.case.insensitive' = 'true', location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_case');

statement ok
COPY (FROM (VALUES ('get /a'), ('POST /b')) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/regex_case/part.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER e'\x01');

query II
SELECT * FROM my_datalake.default.regex_case ORDER BY path;
----
get	/a
POST	/b

query I
SELECT serde_parameters['input.regex.case.insensitive'] FROM glue_get_table_response('my_datalake.default.regex_case');
----
true

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
statement error
CREATE TABLE my_datalake.default.regex_bad (a VARCHAR) WITH (format = 'regex');
----
CREATE TABLE with format 'regex' needs the option 'input.regex'

statement error
CREATE TABLE my_datalake.default.regex_bad (a VARCHAR) WITH (format = 'csv', 'input.regex' = '(.*)');
----
CREATE TABLE option 'input.regex' is only for format 'regex'

# like Hive, the regex is checked when the table is read: one capture group per data column
statement ok
CREATE TABLE my_datalake.default.regex_bad (a VARCHAR, b VARCHAR) WITH (format = 'regex', 'input.regex' = '(\S+)');

statement error
SELECT * FROM my_datalake.default.regex_bad;
----
<REGEX>:Binder Error: The 'input.regex' of Hive table .*regex_bad.* has 1 capture groups, but the table has 2 data columns.*

statement ok
DROP TABLE my_datalake.default.regex_bad;

# RE2 has no backreferences
statement ok
CREATE TABLE my_datalake.default.regex_bad (a VARCHAR) WITH (format = 'regex', 'input.regex' = '(a)\1');

statement error
SELECT * FROM my_datalake.default.regex_bad;
----
<REGEX>:Binder Error: The 'input.regex' of Hive table .*regex_bad.* can not be compiled.*

statement ok
DROP TABLE my_datalake.default.regex_bad;

statement ok
CREATE TABLE my_datalake.default.regex_bad (a INTEGER[]) WITH (format = 'regex', 'input.regex' = '(.*)');

statement error
SELECT * FROM my_datalake.default.regex_bad;
----
<REGEX>:Not implemented Error: Hive table .*regex_bad.* uses RegexSerDe, which reads columns of primitive types only, but column 'a' is INTEGER.*

statement ok
DROP TABLE my_datalake.default.regex_bad;

statement ok
DROP TABLE my_datalake.default.regex_access;

statement ok
DROP TABLE my_datalake.default.regex_types;

statement ok
DROP TABLE my_datalake.default.regex_case;
