require httpfs

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

#---------------------------------------------------------------------------
# Hive JsonSerDe without properties (read)
#---------------------------------------------------------------------------
statement ok
DROP TABLE IF EXISTS my_datalake.default.sp_hive_json_1;

statement ok
CREATE TABLE my_datalake.default.sp_hive_json_1 (id INTEGER, name VARCHAR) WITH (format = 'json');

statement ok
COPY (SELECT * FROM (VALUES ('{"id": 1, "name": "a"}')) t(line)) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/sp_hive_json_1/data.txt' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query TT
SELECT id, name FROM my_datalake.default.sp_hive_json_1 ORDER BY ALL NULLS FIRST;
----
1	a

statement ok
DROP TABLE my_datalake.default.sp_hive_json_1;

