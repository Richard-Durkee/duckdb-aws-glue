require httpfs

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

# fixture_serde_policy_opencsv (scripts/docker-compose.yml) has no SerDe parameters: each case moves it to a location of its own and sets the properties as table parameters, which override SerDe parameters

# a run that failed half way may have left properties set
statement ok
ALTER TABLE my_datalake.default.fixture_serde_policy_opencsv RESET ('escapeChar', 'quoteChar', 'separatorChar', 'serialization.format', 'skip.footer.line.count', 'skip.header.line.count', 'use.null.for.invalid.data');

