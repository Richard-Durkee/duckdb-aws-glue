# name: test/sql/hive/dml/insert/ctas_write_id.test
# description: a CREATE TABLE AS stores its write id as a table parameter, and its rollback drops only a table with that write id
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_wid;

statement ok
DROP TABLE IF EXISTS my_datalake.default.ctas_wid_failed;

statement ok
CREATE TABLE my_datalake.default.ctas_wid AS SELECT i AS id FROM range(3) t(i);

query I
SELECT regexp_matches(parameters['duckdb.write_id'], '^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$')
FROM glue_get_table_response('my_datalake.default.ctas_wid');
----
true

# the files are named after the same write id
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ctas_wid/*') g, glue_get_table_response('my_datalake.default.ctas_wid') t
WHERE NOT starts_with(regexp_extract(g.file, '[^/]*$'), t.parameters['duckdb.write_id'] || '_');
----
0

# a commit that fails after creating the table drops it again: it still carries the statement's write id
statement ok
SET glue_debug_fail_partition_registration = 'InvalidInputException:0';

statement error
CREATE TABLE my_datalake.default.ctas_wid_failed PARTITIONED BY (p) AS SELECT i AS id, i % 2 AS p FROM range(4) t(i);
----
was rolled back

statement ok
RESET glue_debug_fail_partition_registration;

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.ctas_wid_failed');
----
does not exist

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/ctas_wid_failed/**');
----
0

# the name is free again
statement ok
CREATE TABLE my_datalake.default.ctas_wid_failed PARTITIONED BY (p) AS SELECT i AS id, i % 2 AS p FROM range(4) t(i);

query I
SELECT count(*) FROM my_datalake.default.ctas_wid_failed;
----
4

statement ok
DROP TABLE my_datalake.default.ctas_wid;

statement ok
DROP TABLE my_datalake.default.ctas_wid_failed;
