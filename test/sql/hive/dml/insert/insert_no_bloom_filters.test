# name: test/sql/hive/dml/insert/insert_no_bloom_filters.test
# description: Parquet files written to a Hive table have no bloom filters, which a reader would probe with the wrong hash after an INT to BIGINT change
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.no_bloom;

# a dictionary-encoded column, which DuckDB's parquet writer otherwise gives a bloom filter
statement ok
CREATE TABLE my_datalake.default.no_bloom PARTITIONED BY (p) AS
SELECT range AS id, (range % 7)::INTEGER AS g, 's' || (range % 5) AS s, range % 2 AS p FROM range(1000);

statement ok
ALTER TABLE my_datalake.default.no_bloom ALTER COLUMN g TYPE BIGINT;

statement ok
INSERT INTO my_datalake.default.no_bloom SELECT range + 1000, range % 7, 's' || (range % 5), range % 2 FROM range(1000);

query I
SELECT count(*) FROM parquet_metadata('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/no_bloom/*/*.parquet') WHERE bloom_filter_offset IS NOT NULL;
----
0

query II
SELECT count(*), count(DISTINCT g) FROM my_datalake.default.no_bloom WHERE g = 3;
----
286	1

statement ok
DROP TABLE my_datalake.default.no_bloom;
