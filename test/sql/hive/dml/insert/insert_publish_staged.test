# name: test/sql/hive/dml/insert/insert_publish_staged.test
# description: staged files are moved into place at commit, or copied when the file system can not move them
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.publish;

statement ok
CREATE TABLE my_datalake.default.publish (id INTEGER, p INTEGER) PARTITIONED BY (p);

statement ok
INSERT INTO my_datalake.default.publish SELECT i, i % 2 FROM range(4) t(i);

statement ok
CALL enable_logging(level := 'info', storage = 'memory');

# moved where the file system can (httpfs with S3 MoveFile), copied otherwise: either way every staged file is published
statement ok
INSERT INTO my_datalake.default.publish SELECT i, i % 2 FROM range(10, 14) t(i);

query I
SELECT count(*) FROM duckdb_logs WHERE message SIMILAR TO 'Published the 2 staged files of Hive table ''default.publish'': [0-2] moved, [0-2] copied( \(.*\))?';
----
1

statement ok
CALL truncate_duckdb_logs();

statement ok
SET glue_debug_publish_by_copy = true;

statement ok
INSERT INTO my_datalake.default.publish SELECT i, i % 2 FROM range(20, 24) t(i);

statement ok
RESET glue_debug_publish_by_copy;

query T
SELECT regexp_replace(message, '.*: ', '') FROM duckdb_logs WHERE message LIKE 'Published the%';
----
0 moved, 2 copied

query II
SELECT p, count(*) FROM my_datalake.default.publish GROUP BY p ORDER BY p;
----
0	6
1	6

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/publish/.duckdb-staging-*/**');
----
0

statement ok
CALL disable_logging();

statement ok
DROP TABLE my_datalake.default.publish;
