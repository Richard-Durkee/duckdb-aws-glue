# name: test/sql/hive/dml/insert/insert_undo_listing.test
# description: undoing a write deletes the files of a finished statement by name, and lists only the staging root of an unfinished one into an unpartitioned table
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.undo_list;

statement ok
DROP TABLE IF EXISTS my_datalake.default.undo_list_flat;

statement ok
CREATE TABLE my_datalake.default.undo_list (id INTEGER, p INTEGER) PARTITIONED BY (p);

statement ok
INSERT INTO my_datalake.default.undo_list SELECT i, 0 FROM range(3) t(i);

statement ok
CREATE TABLE my_datalake.default.undo_list_flat (id INTEGER);

statement ok
INSERT INTO my_datalake.default.undo_list_flat SELECT i FROM range(3) t(i);

statement ok
CALL enable_logging(level := 'info', storage = 'memory');

# a statement that finished and whose commit fails: its files are known and nothing is listed
statement ok
CALL truncate_duckdb_logs();

statement ok
SET glue_debug_fail_partition_registration = 'InvalidInputException:0';

statement error
INSERT INTO my_datalake.default.undo_list SELECT i, CASE WHEN i < 12 THEN 0 ELSE 1 END FROM range(10, 14) t(i);
----
was rolled back

statement ok
RESET glue_debug_fail_partition_registration;

query T
SELECT regexp_replace(message, '.*: ', '') FROM duckdb_logs WHERE message LIKE 'Undoing a failed write%';
----
deleting its 4 files by name

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/undo_list/**');
----
1

query I
SELECT count(*) FROM my_datalake.default.undo_list;
----
3

# a statement that fails while running into an unpartitioned table: only its staging root is listed
statement ok
CALL truncate_duckdb_logs();

statement error
INSERT INTO my_datalake.default.undo_list_flat SELECT CASE WHEN i = 150000 THEN error('boom') ELSE i END FROM range(200000) t(i);
----
boom

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'Undoing a failed write%listing ''%/undo_list_flat/.duckdb-staging-%'' for its files';
----
1

query I
SELECT count(*) FROM duckdb_logs WHERE message LIKE 'Undoing a failed write%';
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/undo_list_flat/.duckdb-staging-*/**');
----
0

query I
SELECT count(*) FROM my_datalake.default.undo_list_flat;
----
3

statement ok
CALL disable_logging();

statement ok
DROP TABLE my_datalake.default.undo_list;

statement ok
DROP TABLE my_datalake.default.undo_list_flat;
