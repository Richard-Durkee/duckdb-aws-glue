# name: test/sql/hive/dml/insert/insert_write_staging.test
# description: glue_write_staging stages only the files readers would see before the commit: those of existing partitions and unpartitioned tables
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.stg;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stg_flat;

statement ok
DROP TABLE IF EXISTS my_datalake.default.stg_ctas;

query I
SELECT current_setting('glue_write_staging');
----
true

statement ok
CREATE TABLE my_datalake.default.stg (id INTEGER, p INTEGER) PARTITIONED BY (p);

statement ok
INSERT INTO my_datalake.default.stg SELECT i, 0 FROM range(3) t(i);

# rows of the existing partition p=0 are staged, rows of the new partition p=7 are written in place
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg SELECT i, CASE WHEN i < 15 THEN 0 ELSE 7 END FROM range(10, 20) t(i);

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/.duckdb-staging-*/p=0/*');
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/p=0/*');
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/p=7/*');
----
1

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/.duckdb-staging-*/p=7/*');
----
0

# another connection reads neither until the commit
query II con2
SELECT count(*), count(DISTINCT p) FROM my_datalake.default.stg;
----
3	1

statement ok
COMMIT;

query II con2
SELECT count(*), count(DISTINCT p) FROM my_datalake.default.stg;
----
13	2

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/.duckdb-staging-*/**');
----
0

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/p=0/*');
----
2

# an unpartitioned table is staged as a whole
statement ok
CREATE TABLE my_datalake.default.stg_flat (id INTEGER);

statement ok
INSERT INTO my_datalake.default.stg_flat SELECT i FROM range(4) t(i);

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg_flat SELECT i FROM range(10, 16) t(i);

query I con2
SELECT count(*) FROM my_datalake.default.stg_flat;
----
4

query I
SELECT count(*) > 0 FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg_flat/.duckdb-staging-*/*');
----
true

statement ok
COMMIT;

query I con2
SELECT count(*) FROM my_datalake.default.stg_flat;
----
10

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg_flat/.duckdb-staging-*/**');
----
0

# a ROLLBACK leaves neither staged nor in-place files
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg SELECT i, CASE WHEN i < 25 THEN 0 ELSE 8 END FROM range(20, 30) t(i);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/**');
----
3

query I
SELECT count(*) FROM my_datalake.default.stg;
----
13

# without staging, the rows of an existing partition are read before the commit
statement ok
SET glue_write_staging = false;

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg SELECT i, 0 FROM range(30, 32) t(i);

query I con2
SELECT count(*) FROM my_datalake.default.stg;
----
15

statement ok
COMMIT;

statement ok
RESET glue_write_staging;

# CREATE TABLE AS stages nothing: its table is read only once the commit creates it
statement ok
CREATE TABLE my_datalake.default.stg_ctas PARTITIONED BY (p) AS SELECT i AS id, i % 2 AS p FROM range(4) t(i);

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg_ctas/.duckdb-staging-*/**');
----
0

query I
SELECT count(*) FROM my_datalake.default.stg_ctas;
----
4

# a partition that is new when the INSERT is planned, and that another client registers elsewhere before the commit:
# the in-place files would not be read, so the commit fails and deletes them
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg SELECT i, 9 FROM range(40, 43) t(i);

statement ok con2
CALL glue_add_partition('my_datalake.default.stg', {p: '9'}, location := '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg_elsewhere/p=9');

statement error
COMMIT;
----
registered at

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/stg/p=9/*');
----
0

query I
SELECT count(*) FROM my_datalake.default.stg WHERE p = 9;
----
0

# registered at the same location: the commit succeeds and the rows are read once
statement ok con2
CALL glue_drop_partition('my_datalake.default.stg', {p: '9'});

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.stg SELECT i, 9 FROM range(50, 53) t(i);

statement ok con2
CALL glue_add_partition('my_datalake.default.stg', {p: '9'});

statement ok
COMMIT;

query I
SELECT count(*) FROM my_datalake.default.stg WHERE p = 9;
----
3

statement ok
DROP TABLE my_datalake.default.stg;

statement ok
DROP TABLE my_datalake.default.stg_flat;

statement ok
DROP TABLE my_datalake.default.stg_ctas;
