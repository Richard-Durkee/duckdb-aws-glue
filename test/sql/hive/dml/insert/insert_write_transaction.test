# name: test/sql/hive/dml/insert/insert_write_transaction.test
# description: Hive writes are applied when the transaction commits and undone when it rolls back
# group: [insert]

require httpfs

require parquet

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

foreach staging false true

statement ok
SET glue_write_staging = {staging};

statement ok
DROP TABLE IF EXISTS my_datalake.default.wtx_{staging};

statement ok
DROP TABLE IF EXISTS my_datalake.default.wtxu_{staging};

statement ok
CREATE TABLE my_datalake.default.wtx_{staging} (id INTEGER, p INTEGER) PARTITIONED BY (p);

statement ok
CREATE TABLE my_datalake.default.wtxu_{staging} (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wtx_{staging} SELECT i, i % 3 FROM range(6) t(i);

statement ok
INSERT INTO my_datalake.default.wtxu_{staging} SELECT i FROM range(5) t(i);

# ROLLBACK undoes an INSERT into new and existing partitions and into an unpartitioned table
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wtx_{staging} SELECT i, i % 5 FROM range(100, 110) t(i);

statement ok
INSERT INTO my_datalake.default.wtxu_{staging} SELECT i FROM range(100, 110) t(i);

statement ok
ROLLBACK;

query II
SELECT count(*), count(DISTINCT p) FROM my_datalake.default.wtx_{staging};
----
6	3

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.wtx_{staging}');
----
3

query I
SELECT count(*) FROM my_datalake.default.wtxu_{staging};
----
5

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/wtx_{staging}/**');
----
3

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/wtxu_{staging}/.duckdb-staging-*/**');
----
0

# COMMIT applies every statement of the transaction
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wtx_{staging} SELECT i, i % 5 FROM range(100, 110) t(i);

statement ok
INSERT INTO my_datalake.default.wtx_{staging} SELECT i, 7 FROM range(200, 202) t(i);

statement ok
COMMIT;

query III
SELECT count(*), count(DISTINCT p), sum(id) FROM my_datalake.default.wtx_{staging};
----
18	6	1461

query I
SELECT count(*) FROM glue_partitions('my_datalake.default.wtx_{staging}');
----
6

# no staged file stays behind
query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/wtx_{staging}/.duckdb-staging-*/**');
----
0

# a statement that fails while writing leaves nothing
statement error
INSERT INTO my_datalake.default.wtx_{staging} SELECT CASE WHEN i = 150 THEN error('boom') ELSE i END, i % 4 FROM range(300) t(i);
----
boom

query II
SELECT count(*), count(DISTINCT p) FROM my_datalake.default.wtx_{staging};
----
18	6

# CREATE TABLE AS that fails at commit creates no table and leaves no files
statement ok
SET glue_debug_fail_partition_registration = 'InvalidInputException:2';

statement error
CREATE TABLE my_datalake.default.wtx_ctas PARTITIONED BY (p) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ctas_{staging}') AS SELECT i AS id, i % 5 AS p FROM range(20) t(i);
----
rolled back at commit

statement ok
SET glue_debug_fail_partition_registration = '';

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND table_name = 'wtx_ctas';
----
0

query I
SELECT count(*) FROM glob('{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ctas_{staging}/**');
----
0

# CTAS overwrite: the old files go when the statement commits, not when it starts
statement ok
CREATE TABLE my_datalake.default.wtx_ow WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ow_{staging}') AS SELECT range AS id FROM range(3);

statement ok
DROP TABLE my_datalake.default.wtx_ow;

statement error
CREATE TABLE my_datalake.default.wtx_ow WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ow_{staging}', overwrite = true) AS SELECT CASE WHEN range = 4 THEN error('boom') ELSE range END AS id FROM range(5);
----
boom

query I
SELECT count(*) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ow_{staging}/*.parquet');
----
3

statement ok
CREATE TABLE my_datalake.default.wtx_ow WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/wtx_ow_{staging}', overwrite = true) AS SELECT range AS id FROM range(5);

query II
SELECT count(*), sum(id) FROM my_datalake.default.wtx_ow;
----
5	10

query I
SELECT parameters['overwrite'] IS NULL FROM glue_get_table_response('my_datalake.default.wtx_ow');
----
true

statement ok
DROP TABLE my_datalake.default.wtx_ow;

statement ok
DROP TABLE my_datalake.default.wtx_{staging};

statement ok
DROP TABLE my_datalake.default.wtxu_{staging};

endloop

statement ok
RESET glue_write_staging;
