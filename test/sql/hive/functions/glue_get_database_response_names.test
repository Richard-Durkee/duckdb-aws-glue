# name: test/sql/hive/functions/glue_get_database_response_names.test
# description: glue_get_database_response resolves an unqualified database name like a query does
# group: [functions]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP SCHEMA IF EXISTS my_datalake.db_response_names CASCADE;

statement ok
CREATE SCHEMA my_datalake.db_response_names;

query I
SELECT database_name FROM glue_get_database_response('my_datalake.db_response_names');
----
db_response_names

statement ok
USE my_datalake.default;

query I
SELECT database_name FROM glue_get_database_response('db_response_names');
----
db_response_names

query I
SELECT database_name FROM glue_get_database_response('default');
----
default

statement error
SELECT * FROM glue_get_database_response('db_response_missing');
----
does not exist

statement error
SELECT * FROM glue_get_database_response('my_datalake.db_response_names.extra');
----
glue_get_database_response expects a database name

statement ok
USE memory;

statement error
SELECT * FROM glue_get_database_response('main');
----
glue_get_database_response only works on a Glue catalog

statement error
SELECT * FROM glue_get_database_response('db_response_names');
----
does not exist

statement ok
DROP SCHEMA my_datalake.db_response_names;
