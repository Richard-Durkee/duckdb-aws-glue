# name: test/sql/hive/functions/glue_get_table_response_describe.test
# description: glue_get_table_response with 'format' describes a Hive table or one of its partitions
# group: [functions]

require httpfs

require json

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.describe_orders;

statement ok
DROP TABLE IF EXISTS my_datalake.default.describe_flat;

statement ok
CREATE TABLE my_datalake.default.describe_orders (id INTEGER, name VARCHAR, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'parquet', 'parquet.compression' = 'SNAPPY');

statement ok
COMMENT ON COLUMN my_datalake.default.describe_orders.id IS 'the id';

statement ok
CALL glue_add_partition('my_datalake.default.describe_orders', {dt: '2024-01-01'});

# 'describe': the columns and the partition keys
query IIII
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'describe');
----
column	id	int	the id
column	name	string	(empty)
partition key	dt	string	(empty)

# 'formatted': and the table's details, its parameters (sorted) and storage
query IIII
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'FORMATTED') WHERE name != 'created';
----
column	id	int	the id
column	name	string	(empty)
partition key	dt	string	(empty)
table	database	default	(empty)
table	owner	(empty)	(empty)
table	last accessed	(empty)	(empty)
table	location	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/describe_orders	(empty)
table	type	EXTERNAL_TABLE	(empty)
table parameter	EXTERNAL	TRUE	(empty)
table parameter	classification	parquet	(empty)
table parameter	parquet.compression	SNAPPY	(empty)
storage	serde	org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe	(empty)
storage	input format	org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat	(empty)
storage	output format	org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat	(empty)
storage	compressed	false	(empty)
storage	buckets	-1	(empty)
storage	bucket columns	[]	(empty)
storage	sort columns	[]	(empty)
serde parameter	serialization.format	1	(empty)

# the creation time is a timestamp
query I
SELECT TRY_CAST(value AS TIMESTAMP) IS NOT NULL FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'formatted') WHERE category = 'table' AND name = 'created';
----
true

# 'extended': and the Glue definition as JSON
query II
SELECT value::JSON->>'Name', (value::JSON->'StorageDescriptor'->>'Location') = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/describe_orders'
FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'extended') WHERE name = 'glue definition';
----
describe_orders	true

#---------------------------------------------------------------------------
# a partition: its values, location, creation time and storage
#---------------------------------------------------------------------------
query IIII
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'formatted', partition := {DT: '2024-01-01'})
WHERE category IN ('partition', 'storage') AND name NOT IN ('created', 'serde', 'input format', 'output format');
----
partition	values	[2024-01-01]	(empty)
partition	location	{DEFAULT_S3_LOCATION}/{TEST_DIR}/default/describe_orders/dt=2024-01-01	(empty)
partition	last accessed	(empty)	(empty)
storage	compressed	false	(empty)
storage	buckets	-1	(empty)
storage	bucket columns	[]	(empty)
storage	sort columns	[]	(empty)

query I
SELECT value::JSON->'Values'->>0 FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'extended', partition := {dt: '2024-01-01'})
WHERE category = 'partition' AND name = 'glue definition';
----
2024-01-01

# 'describe' of a partition lists the table's columns
query I
SELECT count(*) FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'describe', partition := {dt: '2024-01-01'});
----
3

#---------------------------------------------------------------------------
# errors
#---------------------------------------------------------------------------
statement error
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'formatted', partition := {dt: '1999-01-01'});
----
Table 'default.describe_orders' has no partition dt=1999-01-01

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'formatted', partition := {day: '2024-01-01'});
----
'day' is not a partition key of table 'default.describe_orders'

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', partition := {dt: '2024-01-01'});
----
'partition' describes a partition and needs a 'format'

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.describe_orders', format := 'pretty');
----
unknown format 'pretty', expected 'describe', 'extended' or 'formatted'

statement ok
CREATE TABLE my_datalake.default.describe_flat (id INTEGER) WITH (format = 'parquet');

statement error
SELECT * FROM glue_get_table_response('my_datalake.default.describe_flat', format := 'formatted', partition := {dt: '2024-01-01'});
----
Table 'default.describe_flat' is not partitioned

query IIII
SELECT * FROM glue_get_table_response('my_datalake.default.describe_flat', format := 'describe');
----
column	id	int	(empty)

# other table formats are not described
statement error
SELECT * FROM glue_get_table_response('my_datalake.default.fixture_delta', format := 'describe');
----
'format' describes Hive tables

# without 'format' the response as before
query II
SELECT table_name, len(columns) FROM glue_get_table_response('my_datalake.default.describe_orders');
----
describe_orders	2

statement ok
DROP TABLE my_datalake.default.describe_orders;

statement ok
DROP TABLE my_datalake.default.describe_flat;
