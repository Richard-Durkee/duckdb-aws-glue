# name: test/sql/hive/functions/glue_get_table_response_names.test
# description: glue_get_table_response resolves a partially qualified table name like a query does
# group: [functions]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.response_orders;

statement ok
DROP VIEW IF EXISTS my_datalake.default.response_view;

statement ok
CREATE TABLE my_datalake.default.response_orders (id BIGINT, dt VARCHAR) PARTITIONED BY (dt) WITH (format = 'csv');

statement ok
CREATE VIEW my_datalake.default.response_view AS SELECT 1 AS one;

# the fully qualified name as before
query III
SELECT database_name, table_name, partition_keys[1].name FROM glue_get_table_response('my_datalake.default.response_orders');
----
default	response_orders	dt

statement ok
CREATE TABLE memory.main.local_table (id INTEGER);

statement ok
USE my_datalake.default;

query II
SELECT database_name, table_name FROM glue_get_table_response('response_orders');
----
default	response_orders

query II
SELECT database_name, table_name FROM glue_get_table_response('default.response_orders');
----
default	response_orders

query II
SELECT table_name, glue_table_type FROM glue_get_table_response('response_view');
----
response_view	VIRTUAL_VIEW

statement error
SELECT * FROM glue_get_table_response('response_missing');
----
does not exist

statement ok
USE memory;

statement error
SELECT * FROM glue_get_table_response('local_table');
----
only works on tables of a Glue catalog

statement error
SELECT * FROM glue_get_table_response('response_orders');
----
does not exist

statement ok
DROP VIEW my_datalake.default.response_view;

statement ok
DROP TABLE my_datalake.default.response_orders;
