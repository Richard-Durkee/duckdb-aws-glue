# name: test/sql/hive/functions/prefetch_table.test
# description: glue_prefetch_table puts a table definition into the metadata cache, so the table's lookup makes no GetTable call
# group: [functions]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.pft_table;

statement ok
CREATE TABLE my_datalake.default.pft_table (id INTEGER, name VARCHAR)
WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/pft_table');

statement ok
INSERT INTO my_datalake.default.pft_table VALUES (1, 'alice'), (2, 'bob');

# the Glue operation is a request header, which HTTP logs redact by default
statement ok
SET redact_http_logs = false;

statement ok
CALL enable_logging('HTTP', storage := 'memory');

# under the default transaction scope a prefetch outside a transaction would end with its own statement
statement ok
attach '{GLUE_CATALOG_ID}' as pft_cold (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement error
CALL glue_prefetch_table('pft_cold.default.pft_table', '{"location": "{DEFAULT_S3_LOCATION}/{TEST_DIR}/pft_table", "serde_library": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe", "columns": [{"name": "id", "type": "int"}]}');
----
<REGEX>:.*the metadata cache is kept for the transaction.*

# inside a transaction the table is read as prefetched, here with only its first column, and Glue is not asked for it
statement ok
BEGIN;

statement ok
CALL truncate_duckdb_logs();

query III
CALL glue_prefetch_table('pft_cold.default.pft_table', '{"location": "{DEFAULT_S3_LOCATION}/{TEST_DIR}/pft_table", "serde_library": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe", "columns": [{"name": "id", "type": "int"}]}');
----
default	pft_table	prefetched

query I
SELECT * FROM pft_cold.default.pft_table ORDER BY id;
----
1
2

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.GetTable';
----
0

# a table already in the cache keeps its definition
query III
CALL glue_prefetch_table('pft_cold.default.pft_table', '{"location": "{DEFAULT_S3_LOCATION}/{TEST_DIR}/pft_table", "serde_library": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe", "columns": [{"name": "id", "type": "int"}, {"name": "name", "type": "string"}]}');
----
default	pft_table	already cached

query I
SELECT count(*) FROM (DESCRIBE pft_cold.default.pft_table);
----
1

statement ok
COMMIT;

# under the connection scope the prefetch lasts beyond its statement
statement ok
SET glue_metadata_cache_scope = 'connection';

statement ok
attach '{GLUE_CATALOG_ID}' as pft_conn (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
CALL truncate_duckdb_logs();

query III
CALL glue_prefetch_table('pft_conn.default.pft_table', '{"location": "{DEFAULT_S3_LOCATION}/{TEST_DIR}/pft_table", "serde_library": "org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe", "columns": [{"name": "id", "type": "int"}, {"name": "name", "type": "string", "comment": null}], "partition_keys": [], "parameters": {"classification": "parquet"}, "serde_parameters": {}, "glue_table_type": "EXTERNAL_TABLE", "table_type": "HIVE", "database_name": "default", "table_name": "pft_table"}');
----
default	pft_table	prefetched

query II
SELECT id, name FROM pft_conn.default.pft_table ORDER BY id;
----
1	alice
2	bob

query I
SELECT count(*) FROM duckdb_logs_parsed('HTTP') WHERE request.headers['x-amz-target'] = 'AWSGlue.GetTable';
----
0

# the table must be fully qualified: a partial name is resolved by asking Glue for the table
statement error
CALL glue_prefetch_table('default.pft_table', '{}');
----
<REGEX>:.*needs the fully qualified table.*

statement error
CALL glue_prefetch_table('memory.main.pft_table', '{}');
----
<REGEX>:.*only works on tables of a Glue catalog.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_table', NULL);
----
<REGEX>:.*must not be NULL.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', 'not json');
----
<REGEX>:.*not valid JSON.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '[1, 2]');
----
<REGEX>:.*must be a JSON object.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"serde_library": "x", "columns": [{"name": "id", "type": "int"}]}');
----
<REGEX>:.*'location' is required.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": []}');
----
<REGEX>:.*'columns' must list the table's columns.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": [{"name": "id"}]}');
----
<REGEX>:.*'columns\[0\]\.type' is required.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": 5, "serde_library": "x", "columns": [{"name": "id", "type": "int"}]}');
----
<REGEX>:.*'location' must be a string.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": [{"name": "id", "type": "int"}], "number_of_buckets": "4"}');
----
<REGEX>:.*'number_of_buckets' must be an integer.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": [{"name": "id", "type": "int"}], "sort_columns": [{"name": "id", "sort_order": "UP"}]}');
----
<REGEX>:.*'sort_columns\[0\]\.sort_order' must be 'ASC' or 'DESC'.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": [{"name": "id", "type": "int"}], "locaton": "s3://b/u"}');
----
<REGEX>:.*unknown field 'locaton'.*

statement error
CALL glue_prefetch_table('pft_conn.default.pft_bad', '{"location": "s3://b/t", "serde_library": "x", "columns": [{"name": "id", "type": "int"}], "glue_table_type": "VIRTUAL_VIEW"}');
----
<REGEX>:.*views can not be prefetched.*

statement ok
RESET glue_metadata_cache_scope;

statement ok
DROP TABLE my_datalake.default.pft_table;
