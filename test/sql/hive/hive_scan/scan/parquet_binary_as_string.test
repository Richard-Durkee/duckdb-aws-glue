# name: test/sql/hive/hive_scan/scan/parquet_binary_as_string.test
# description: A parquet BYTE_ARRAY column without a STRING annotation reads as text when Glue declares the column string, and as bytes when it declares it binary
# group: [scan]

require httpfs

require glue

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.bytes_as_text;

statement ok
DROP TABLE IF EXISTS my_datalake.default.bytes_as_binary;

statement ok
DROP TABLE IF EXISTS my_datalake.default.bytes_invalid;

statement ok
DROP TABLE IF EXISTS my_datalake.default.bytes_mixed;

statement ok
DROP TABLE IF EXISTS my_datalake.default.bytes_nested;

# a BLOB column is written as BYTE_ARRAY without a logical type
statement ok
COPY (SELECT * FROM (VALUES (1, encode('plain')), (2, encode('ü€😀')), (3, encode('tab' || chr(9) || 'here')), (4, encode('line' || chr(10) || 'break')), (5, NULL)) t(id, c) ORDER BY id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_as_text/data.parquet' (FORMAT PARQUET);

query I
SELECT typeof(c) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_as_text/data.parquet') LIMIT 1;
----
BLOB

statement ok
CREATE TABLE my_datalake.default.bytes_as_text (id INTEGER, c VARCHAR) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_as_text');

# the bytes are the text, not an escaped rendering of them
query IIII
SELECT id, replace(replace(c, chr(9), '<TAB>'), chr(10), '<LF>'), length(c), typeof(c) FROM my_datalake.default.bytes_as_text ORDER BY id;
----
1	plain	5	VARCHAR
2	ü€😀	3	VARCHAR
3	tab<TAB>here	8	VARCHAR
4	line<LF>break	10	VARCHAR
5	NULL	NULL	VARCHAR

# filters and functions see the decoded text
query I
SELECT id FROM my_datalake.default.bytes_as_text WHERE c = 'ü€😀';
----
2

query I
SELECT upper(c) FROM my_datalake.default.bytes_as_text WHERE id = 1;
----
PLAIN

# a scan that reads no column (count(*) passes only a virtual column id) and one that mixes a virtual column in
query I
SELECT count(*) FROM my_datalake.default.bytes_as_text;
----
5

query II
SELECT c, filename LIKE '%bytes_as_text%' FROM my_datalake.default.bytes_as_text WHERE id = 2;
----
ü€😀	true

# a column Glue declares binary keeps the bytes
statement ok
COPY (SELECT * FROM (VALUES (1, '\xC3\xBC'::BLOB), (2, '\x00\xFF'::BLOB)) t(id, b) ORDER BY id) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_as_binary/data.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE my_datalake.default.bytes_as_binary (id INTEGER, b BLOB) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_as_binary');

query III
SELECT id, b, typeof(b) FROM my_datalake.default.bytes_as_binary ORDER BY id;
----
1	\xC3\xBC	BLOB
2	\x00\xFF	BLOB

# the session's binary_as_string does not decide: the Glue type does
statement ok
SET binary_as_string = true;

query III
SELECT id, b, typeof(b) FROM my_datalake.default.bytes_as_binary ORDER BY id;
----
1	\xC3\xBC	BLOB
2	\x00\xFF	BLOB

statement ok
RESET binary_as_string;

# bytes that are not UTF-8 in a string column are an error naming the table and column, not an escaped value, also
# when the filter is evaluated inside the reader
statement ok
COPY (SELECT 1 AS id, '\xFF\xFE'::BLOB AS c) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_invalid/data.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE my_datalake.default.bytes_invalid (id INTEGER, c VARCHAR) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_invalid');

statement error
SELECT c FROM my_datalake.default.bytes_invalid;
----
Glue table 'default.bytes_invalid': column "c" is declared string, but its parquet file holds bytes that are not UTF-8; declare the column binary to read them as is

statement error
SELECT id FROM my_datalake.default.bytes_invalid WHERE c = 'x';
----
Glue table 'default.bytes_invalid': column "c" is declared string, but its parquet file holds bytes that are not UTF-8

# a file holding an annotated string column next to an unannotated one: both read as text, and as the same text
statement ok
COPY (SELECT 1 AS id, 'ü€😀' AS s, encode('ü€😀') AS c) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_mixed/data.parquet' (FORMAT PARQUET);

query II
SELECT typeof(s), typeof(c) FROM read_parquet('{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_mixed/data.parquet');
----
VARCHAR	BLOB

statement ok
CREATE TABLE my_datalake.default.bytes_mixed (id INTEGER, s VARCHAR, c VARCHAR) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_mixed');

query III
SELECT id, s, c FROM my_datalake.default.bytes_mixed WHERE s = c;
----
1	ü€😀	ü€😀

# hive_scan without a catalog follows the schema it is given the same way
query I
SELECT c FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_mixed', schema := {id: 'INTEGER', s: 'VARCHAR', c: 'VARCHAR'}) WHERE c = 'ü€😀';
----
ü€😀

query I
SELECT c FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_mixed', schema := {id: 'INTEGER', s: 'VARCHAR', c: 'BLOB'});
----
\xC3\xBC\xE2\x82\xAC\xF0\x9F\x98\x80

# a schema type that is an alias of VARCHAR (JSON) is not rewritten: the column keeps its type and the reader's own
# BLOB -> JSON conversion, which renders the bytes as an escaped JSON string
require json

statement ok
COPY (SELECT 1 AS id, '{"a": 1}'::BLOB AS c) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_json/data.parquet';

query II
SELECT c, typeof(c) FROM hive_scan('{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_json', schema := {id: 'INTEGER', c: 'JSON'});
----
"{\\x22a\\x22: 1}"	JSON

# the same bytes inside a struct are converted by the reader's nested cast and keep the escaped form (documented)
statement ok
COPY (SELECT 1 AS id, {'s': encode('ü'), 'n': 1} AS st) TO '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_nested/data.parquet' (FORMAT PARQUET);

statement ok
CREATE TABLE my_datalake.default.bytes_nested (id INTEGER, st STRUCT(s VARCHAR, n INTEGER)) WITH (location = '{DEFAULT_S3_LOCATION}/{TEST_DIR}/bytes_nested');

query I
SELECT st.s FROM my_datalake.default.bytes_nested;
----
\xC3\xBC

statement ok
DROP TABLE my_datalake.default.bytes_as_text;

statement ok
DROP TABLE my_datalake.default.bytes_as_binary;

statement ok
DROP TABLE my_datalake.default.bytes_invalid;

statement ok
DROP TABLE my_datalake.default.bytes_mixed;

statement ok
DROP TABLE my_datalake.default.bytes_nested;
