# name: test/sql/hive/logging/glue_query_profile_metrics.test
# description: The query profile counts the Glue API requests of a query and what its scan loads and lists
# group: [logging]

require httpfs

require glue

require json

require-env GLUE_CATALOG_ID

statement ok
attach '{GLUE_CATALOG_ID}' as my_datalake (
    TYPE glue,
    ENDPOINT '{GLUE_ENDPOINT}',
    DEFAULT_LOCATION '{DEFAULT_S3_LOCATION}/{TEST_DIR}'
);

statement ok
DROP TABLE IF EXISTS my_datalake.default.gpm_parts;

statement ok
CREATE TABLE my_datalake.default.gpm_parts (id INTEGER, dt VARCHAR) PARTITIONED BY (dt);

statement ok
INSERT INTO my_datalake.default.gpm_parts VALUES (1, 'a'), (2, 'b'), (3, 'c');

# a second connection to the catalog that has not looked at the table, so the query has to ask Glue for it
statement ok
attach '{GLUE_CATALOG_ID}' as gpm_cold (TYPE glue, ENDPOINT '{GLUE_ENDPOINT}');

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/glue_select_profile.json';

query I
SELECT count(*) FROM gpm_cold.default.gpm_parts WHERE dt = 'b';
----
1

statement ok
PRAGMA disable_profiling;

# One partition of the three is read, from one listing that finds its one file
query IIIIII
SELECT glue.api_requests > 0, glue.api_request_time > 0, glue.partitions_loaded, glue.partitions_read, glue.listings,
    glue.files_listed
FROM read_json('{TEST_DIR}/glue_select_profile.json');
----
true	true	3	1	1	1

# The figures belong to the query that did the work: a query that does not touch Glue reports none
statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/glue_plain_profile.json';

query I
SELECT 42;
----
42

statement ok
PRAGMA disable_profiling;

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_json('{TEST_DIR}/glue_plain_profile.json'))
WHERE column_name = 'glue';
----
0

# Without profiling nothing is counted, and the query is unaffected
query I
SELECT count(*) FROM my_datalake.default.gpm_parts;
----
3

statement ok
DROP TABLE my_datalake.default.gpm_parts;
